---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getBreadcrumbStructuredData } from '../utils/seo';

const { frontmatter } = Astro.props;
const articleTitle = frontmatter.metaTitle || `${frontmatter.title} | Center for PTA`;
const displayDate = frontmatter.date
  ? new Date(frontmatter.date).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    })
  : '';
const category = frontmatter.category || 'Clinical Insight';
const reviewedBy = frontmatter.reviewedBy;
const tocHeadings = (Astro.props.headings || []).filter((heading) => heading.depth === 2 || heading.depth === 3);
const existingStructuredData = Array.isArray(frontmatter.structuredData)
  ? frontmatter.structuredData
  : frontmatter.structuredData
    ? [frontmatter.structuredData]
    : [];
const articleStructuredData = [
  ...existingStructuredData,
  getBreadcrumbStructuredData([
    { name: 'Home', path: '/' },
    { name: 'Insights', path: '/blog/' },
    { name: frontmatter.title, path: Astro.url.pathname }
  ])
];
---

<Layout
  title={articleTitle}
  description={frontmatter.description}
  image={frontmatter.image}
  imageWidth={frontmatter.imageWidth || 1600}
  imageHeight={frontmatter.imageHeight || 900}
  ogType="article"
  publishedTime={frontmatter.date}
  modifiedTime={frontmatter.updatedDate || frontmatter.date}
  author={frontmatter.author}
  reviewedBy={reviewedBy}
  citations={frontmatter.citations || []}
  schemaType="BlogPosting"
  srAlternatePath={frontmatter.srAlternatePath === false ? false : frontmatter.srPath}
  faqItems={frontmatter.faqItems || []}
  structuredData={articleStructuredData}
>
  <Navbar alternatePath={frontmatter.srPath} />

  <section class="pt-32 md:pt-40 bg-[#fbfaf7] border-b border-[#e8e2d8]">
    <div class="max-w-[1180px] mx-auto px-5 md:px-10 xl:px-16 pb-14 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-10 overflow-x-auto">
        <ol class="flex min-w-0 items-center gap-2 whitespace-nowrap text-sm font-semibold text-gray-600">
          <li><a href="/" class="hover:text-[#2f594f] transition-colors">Home</a></li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li><a href="/blog/" class="hover:text-[#2f594f] transition-colors">Insights</a></li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li class="min-w-0">
            <span aria-current="page" class="block max-w-[55vw] truncate font-bold text-[#2f594f] md:max-w-md">
              {frontmatter.title}
            </span>
          </li>
        </ol>
      </nav>

      <div class:list={[
        'grid gap-10 xl:gap-16 items-end',
        reviewedBy ? 'lg:grid-cols-[minmax(0,1fr)_340px]' : ''
      ]}>
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-6 text-sm font-semibold text-[#2f594f]">
            <span>{category}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#c8b98d]" aria-hidden="true"></span>
            <time datetime={frontmatter.date}>{displayDate}</time>
          </div>
          <h1 class="text-4xl md:text-5xl xl:text-[64px] font-extrabold text-[#1a1a1a] leading-[1.04] tracking-tight max-w-4xl">
            {frontmatter.title}
          </h1>
          {frontmatter.description && (
            <p class="mt-7 text-lg md:text-xl text-gray-700 leading-relaxed max-w-3xl">
              {frontmatter.description}
            </p>
          )}
        </div>

        {reviewedBy && (
          <aside class="border-l-4 border-[#2f594f] pl-6 py-2">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#8b7a56] mb-3">Reviewed Resource</p>
            <p class="text-base font-bold text-[#1a1a1a] leading-snug">{reviewedBy}</p>
            {frontmatter.lastReviewed && (
              <p class="mt-2 text-sm text-gray-600">Last reviewed: {frontmatter.lastReviewed}</p>
            )}
            <p class="mt-5 text-sm text-gray-600 leading-relaxed">
              Educational guidance from Center for PTA in Schaumburg, IL.
            </p>
          </aside>
        )}
      </div>
    </div>
  </section>

  <section class="py-12 xl:py-20 bg-white relative">
    <div class="max-w-[1120px] mx-auto px-5 md:px-10 xl:px-16">
      {frontmatter.image && (
        <div class="mb-12 overflow-hidden rounded-2xl border border-[#e8e2d8] shadow-[0_24px_80px_rgba(47,89,79,0.12)]">
          <img
            src={frontmatter.image}
            alt={frontmatter.imageAlt || frontmatter.title}
            width="1600"
            height="900"
            decoding="async"
            class="w-full aspect-[16/9] object-cover"
          />
        </div>
      )}

      <div class:list={[
        'grid gap-10 xl:gap-12 items-start',
        tocHeadings.length > 0 ? 'lg:grid-cols-[250px_minmax(0,820px)]' : ''
      ]}>
        {tocHeadings.length > 0 && (
          <aside class="lg:sticky lg:top-28 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:pr-2">
            <nav aria-label="Article contents" class="border-y lg:border-y-0 lg:border-l border-[#e8e2d8] lg:pl-5 py-5 lg:py-1">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#8b7a56]">In This Article</p>
              <ol class="mt-4 max-h-72 lg:max-h-none overflow-y-auto lg:overflow-visible pr-2 lg:pr-0 space-y-1.5">
                {tocHeadings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        'group block rounded-md px-3 py-2 text-sm leading-snug transition-colors hover:bg-[#f4f1ea] hover:text-[#1a1a1a]',
                        heading.depth === 2
                          ? 'font-bold text-[#2f594f]'
                          : 'ml-4 font-semibold text-gray-600'
                      ]}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}

        <article class="prose prose-lg md:prose-xl prose-stone max-w-[820px] mx-auto
            prose-headings:text-[#1a1a1a] prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:mb-6 prose-headings:mt-12
            prose-h2:text-3xl md:prose-h2:text-4xl
            prose-h3:text-2xl md:prose-h3:text-3xl prose-h3:text-[#147b6a]
            prose-p:text-gray-700 prose-p:leading-relaxed prose-p:mb-8
            prose-a:text-[#2f594f] hover:prose-a:text-[#147b6a] prose-a:font-semibold prose-a:underline prose-a:decoration-2 prose-a:underline-offset-4
            prose-strong:text-[#1a1a1a] prose-strong:font-extrabold
            prose-ul:text-gray-700 prose-ul:mb-8 prose-li:my-2 prose-li:leading-relaxed
            prose-blockquote:border-l-4 prose-blockquote:border-[#fcc13e] prose-blockquote:pl-6 prose-blockquote:py-1 prose-blockquote:text-gray-800 prose-blockquote:italic prose-blockquote:font-medium text-left">
          <slot />
        </article>
      </div>
      
      <div class="max-w-[820px] mx-auto mt-16 pt-8 border-t border-gray-200 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <a href="/blog/" class="inline-flex items-center text-[#2f594f] font-bold hover:text-[#1a1a1a] transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path></svg>
          Back to Insights
        </a>
        <a href="/contact/" class="inline-flex items-center justify-center px-5 py-3 bg-[#2f594f] text-white text-sm font-bold rounded-full shadow-lg shadow-[#2f594f]/15 hover:bg-[#24473f] transition-colors">
          Contact the Practice
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  :where(article [id]) {
    scroll-margin-top: 7rem;
  }
</style>
