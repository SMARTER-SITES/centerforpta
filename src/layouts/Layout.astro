---
import {
  defaultDescription,
  defaultTitle,
  getFaqStructuredData,
  getBaseStructuredData,
  getWebPageStructuredData,
  getWebSiteStructuredData,
  resolveMetaImage,
  siteName,
  siteUrl
} from '../utils/seo';
import type { FaqItem } from '../utils/seo';
import WebMcpProvider from '../components/WebMcpProvider.astro';

import { getContributor, getReviewMetadata, getTranslationMetadata } from '../utils/content-schema.js';
import { imageDimensions } from '../utils/responsive-image';

interface CitationItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  authorId?: string;
  reviewerId?: string;
  lastReviewedDate?: string;
  medicalContent?: boolean;
  topic?: string;
  relatedServicePaths?: string[];
  translationPath?: string | false;
  reviewedBy?: string;
  citations?: CitationItem[];
  schemaType?: 'Article' | 'BlogPosting';
  canonicalPath?: string;
  srAlternatePath?: string | false;
  previousPath?: string;
  nextPath?: string;
  noIndex?: boolean;
  faqItems?: FaqItem[];
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = defaultTitle,
  description = defaultDescription,
  image,
  imageWidth,
  imageHeight,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author = 'Dr. Jelena Djurovic',
  authorId, reviewerId, lastReviewedDate, medicalContent = false, topic,
  relatedServicePaths = [], translationPath,
  reviewedBy,
  citations = [],
  schemaType = 'Article',
  canonicalPath,
  srAlternatePath,
  previousPath,
  nextPath,
  noIndex = false,
  faqItems = [],
  structuredData: customStructuredData
} = Astro.props;

const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? siteUrl).toString();
const isSiteHomepage = Astro.url.pathname === '/';
const defaultSrPath = Astro.url.pathname === '/' ? '/sr/' : `/sr${Astro.url.pathname}`;
const hasSrAlternate = srAlternatePath !== false;
const srPath = typeof srAlternatePath === 'string' ? srAlternatePath : defaultSrPath;
const srAlternateUrl = new URL(srPath, Astro.site ?? siteUrl).toString();
const previousUrl = previousPath ? new URL(previousPath, Astro.site ?? siteUrl).toString() : undefined;
const nextUrl = nextPath ? new URL(nextPath, Astro.site ?? siteUrl).toString() : undefined;
const socialImage = resolveMetaImage(image);
const articleAuthor = getContributor(authorId, author);
const reviewMetadata = getReviewMetadata(reviewerId, reviewedBy, lastReviewedDate);
const dimensions = imageDimensions(image);
const structuredImage = {
  '@type': 'ImageObject', url: socialImage,
  ...(dimensions.width && dimensions.height
    ? { width: dimensions.width, height: dimensions.height }
    : imageWidth && imageHeight ? { width: imageWidth, height: imageHeight } : {})
};

const customStructuredDataItems = Array.isArray(customStructuredData)
  ? customStructuredData
  : customStructuredData
    ? [customStructuredData]
    : [];

const webPageSchemaTypes = new Set([
  'AboutPage',
  'CollectionPage',
  'ContactPage',
  'MedicalWebPage',
  'ProfilePage',
  'SearchResultsPage',
  'WebPage'
]);
const hasCustomWebPageEntity = customStructuredDataItems.some((item) => {
  const itemTypes = Array.isArray(item['@type']) ? item['@type'] : [item['@type']];
  return itemTypes.some((itemType) => typeof itemType === 'string' && webPageSchemaTypes.has(itemType));
});
const serviceEntity = customStructuredDataItems.find((item) => item['@type'] === 'Service');
const mainEntityId = ogType === 'article' ? `${canonicalUrl}#article` : serviceEntity?.['@id'] as string | undefined;
const webPageStructuredData = !noIndex && !hasCustomWebPageEntity
  ? getWebPageStructuredData({
      name: title,
      description,
      url: canonicalUrl,
      language: 'en-US',
      image: socialImage,
      imageWidth: structuredImage.width, imageHeight: structuredImage.height,
      medicalContent, mainEntityId, topic, ...reviewMetadata
    })
  : null;

const structuredData = [
  isSiteHomepage ? getWebSiteStructuredData() : null,
  getBaseStructuredData(),
  webPageStructuredData,
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': schemaType,
        '@id': `${canonicalUrl}#article`,
        url: canonicalUrl,
        headline: title,
        description,
        inLanguage: 'en-US',
        image: structuredImage,
        author: articleAuthor,
        publisher: {
          '@type': 'Organization',
          '@id': `${siteUrl}/#professional-service`,
          name: siteName,
          logo: {
            '@type': 'ImageObject',
            url: resolveMetaImage('/images/logo.png')
          }
        },
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        ...(topic ? { about: { '@type': 'Thing', name: topic } } : {}),
        ...(relatedServicePaths.length ? { mentions: relatedServicePaths.map((path) => ({
          '@id': `${new URL(path, siteUrl).toString()}#service`
        })) } : {}),
        ...getTranslationMetadata('en', translationPath),
        ...(citations.length > 0
          ? {
              citation: citations.map((citation) => ({
                '@type': 'CreativeWork',
                name: citation.name,
                url: citation.url
              }))
            }
          : {}),
        mainEntityOfPage: {
          '@id': `${canonicalUrl}#webpage`
        }
      }
    : null,
  faqItems.length > 0
    ? getFaqStructuredData(faqItems, { pageUrl: canonicalUrl, language: 'en-US' })
    : null,
  ...customStructuredDataItems
].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="describedby" href="/llms.txt" type="text/markdown" />
    {previousUrl && <link rel="prev" href={previousUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    {hasSrAlternate && <link rel="alternate" hreflang="sr" href={srAlternateUrl} />}
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta name="theme-color" content="#2f594f" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    {hasSrAlternate && <meta property="og:locale:alternate" content="sr_RS" />}
    <meta property="og:image" content={socialImage} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="google-site-verification" content="ctEdt7ugcXaqhwULL18mjtGCnqqwiWHvB7cQrW-o190" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N367CP9MSE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-N367CP9MSE');
    </script>
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && ogType === 'article' && <meta property="article:author" content={author} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="font-inter bg-white antialiased">
    <slot />
    <WebMcpProvider />
    <script>
      import "../scripts/contact-forms.js";
      import "../scripts/contact-actions.js";
    </script>
  </body>
</html>
