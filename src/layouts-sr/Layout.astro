---
import {
  defaultDescription,
  defaultTitle,
  getFaqStructuredData,
  getBaseStructuredData,
  getWebPageStructuredData,
  getWebSiteStructuredData,
  resolveMetaImage,
  siteName,
  siteUrl
} from '../utils-sr/seo';
import type { FaqItem } from '../utils-sr/seo';
import WebMcpProvider from '../components-sr/WebMcpProvider.astro';

interface CitationItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  reviewedBy?: string;
  citations?: CitationItem[];
  schemaType?: 'Article' | 'BlogPosting';
  canonicalPath?: string;
  enAlternatePath?: string | false;
  previousPath?: string;
  nextPath?: string;
  noIndex?: boolean;
  faqItems?: FaqItem[];
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = defaultTitle,
  description = defaultDescription,
  image,
  imageWidth,
  imageHeight,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author = 'Dr. Jelena Djurovic',
  reviewedBy,
  citations = [],
  schemaType = 'Article',
  canonicalPath,
  enAlternatePath,
  previousPath,
  nextPath,
  noIndex = false,
  faqItems = [],
  structuredData: customStructuredData
} = Astro.props;

const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? siteUrl).toString();
const isSiteHomepage = Astro.url.pathname === '/sr/';
const defaultEnglishPath = Astro.url.pathname.replace(/^\/sr(?=\/|$)/, '') || '/';
const hasEnglishAlternate = enAlternatePath !== false;
const englishPath = typeof enAlternatePath === 'string' ? enAlternatePath : defaultEnglishPath;
const englishAlternateUrl = new URL(englishPath, Astro.site ?? siteUrl).toString();
const previousUrl = previousPath ? new URL(previousPath, Astro.site ?? siteUrl).toString() : undefined;
const nextUrl = nextPath ? new URL(nextPath, Astro.site ?? siteUrl).toString() : undefined;
const socialImage = resolveMetaImage(image);
const articleAuthor = author === siteName
  ? {
      '@type': 'Organization',
      '@id': `${siteUrl}/#professional-service`,
      name: siteName,
      url: siteUrl
    }
  : {
      '@type': 'Person',
      '@id': author.includes('Jelena Djurovic') ? `${siteUrl}/dr-jelena-djurovic/#person` : undefined,
      name: author,
      url: author.includes('Jelena Djurovic') ? `${siteUrl}/dr-jelena-djurovic/` : undefined
    };
const articleReviewer = reviewedBy
  ? {
      '@type': 'Person',
      '@id': `${siteUrl}/dr-jelena-djurovic/#person`,
      name: reviewedBy,
      url: `${siteUrl}/dr-jelena-djurovic/`
    }
  : undefined;

const customStructuredDataItems = Array.isArray(customStructuredData)
  ? customStructuredData
  : customStructuredData
    ? [customStructuredData]
    : [];

const webPageSchemaTypes = new Set([
  'AboutPage',
  'CollectionPage',
  'ContactPage',
  'MedicalWebPage',
  'ProfilePage',
  'SearchResultsPage',
  'WebPage'
]);
const hasCustomWebPageEntity = customStructuredDataItems.some((item) => {
  const itemTypes = Array.isArray(item['@type']) ? item['@type'] : [item['@type']];
  return itemTypes.some((itemType) => typeof itemType === 'string' && webPageSchemaTypes.has(itemType));
});
const webPageStructuredData = !noIndex && !hasCustomWebPageEntity
  ? getWebPageStructuredData({
      name: title,
      description,
      url: canonicalUrl,
      language: 'sr-Latn',
      image: socialImage
    })
  : null;

const structuredData = [
  isSiteHomepage ? getWebSiteStructuredData() : null,
  getBaseStructuredData(),
  webPageStructuredData,
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': schemaType,
        '@id': `${canonicalUrl}#article`,
        url: canonicalUrl,
        headline: title,
        description,
        inLanguage: 'sr-Latn',
        image: socialImage,
        author: articleAuthor,
        publisher: {
          '@type': 'Organization',
          '@id': `${siteUrl}/#professional-service`,
          name: siteName,
          logo: {
            '@type': 'ImageObject',
            url: resolveMetaImage('/images/logo.png')
          }
        },
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        reviewedBy: articleReviewer,
        ...(citations.length > 0
          ? {
              citation: citations.map((citation) => ({
                '@type': 'CreativeWork',
                name: citation.name,
                url: citation.url
              }))
            }
          : {}),
        mainEntityOfPage: {
          '@id': `${canonicalUrl}#webpage`
        }
      }
    : null,
  faqItems.length > 0
    ? getFaqStructuredData(faqItems, { pageUrl: canonicalUrl, language: 'sr-Latn' })
    : null,
  ...customStructuredDataItems
].filter(Boolean);
---

<!doctype html>
<html lang="sr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="describedby" href="/llms.txt" type="text/markdown" />
    {previousUrl && <link rel="prev" href={previousUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <link rel="alternate" hreflang="sr" href={canonicalUrl} />
    {hasEnglishAlternate && <link rel="alternate" hreflang="en" href={englishAlternateUrl} />}
    {hasEnglishAlternate && <link rel="alternate" hreflang="x-default" href={englishAlternateUrl} />}
    <meta name="theme-color" content="#2f594f" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="sr_RS" />
    {hasEnglishAlternate && <meta property="og:locale:alternate" content="en_US" />}
    <meta property="og:image" content={socialImage} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="google-site-verification" content="ctEdt7ugcXaqhwULL18mjtGCnqqwiWHvB7cQrW-o190" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N367CP9MSE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-N367CP9MSE');
    </script>
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && ogType === 'article' && <meta property="article:author" content={author} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="font-inter bg-white antialiased">
    <slot />
    <WebMcpProvider />
  </body>
</html>
