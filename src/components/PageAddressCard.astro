---
import { mapUrl } from '../utils/seo';
---

<section class="py-10 bg-[#fcfbf9]">
  <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
    <div class="rounded-[1.75rem] border border-gray-100 bg-white p-6 md:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#2f594f] mb-3">Office Address</p>
      <div class="text-lg text-gray-700 leading-relaxed">
        <p class="font-bold text-[#1a1a1a]">Center for PTA</p>
        <p>1320 Tower Rd, Suite 156</p>
        <p>Schaumburg, IL 60173</p>
        <a
          href={mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-base font-bold text-[#0d5c4e] hover:text-[#2f594f] transition-colors"
        >
          Get directions
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
