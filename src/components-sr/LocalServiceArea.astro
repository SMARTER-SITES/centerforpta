---
interface Props {
  serviceName: string;
  title?: string;
  paragraphs?: string[];
}

const {
  serviceName,
  title = `${serviceName} u Schaumburgu, IL i online uz fizičku lokaciju u Illinoisu`,
  paragraphs = [
    'Dr Jelena Djurovic nudi rad uživo u Schaumburgu, Illinois, kao i online seanse kada se klijent fizički nalazi u Illinoisu u trenutku seanse. Tako možete izabrati format koji odgovara vašem rasporedu, komforu i nivou podrške koji vam je potreban.',
    'Ako tražite licenciranog kliničkog psihologa blizu Schaumburga ili preferirate online terapiju dok se fizički nalazite u Illinoisu, možete se javiti preko kontakt stranice i pitati za uklapanje, termine i sledeće korake.'
  ]
} = Astro.props;
---

<section class="py-16 xl:py-24 bg-[#fcfbf9] relative">
  <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
    <div class="bg-white p-8 md:p-12 rounded-[2rem] border border-gray-100">
      <div class="max-w-4xl">
        <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a] mb-6">
          {title}
        </h2>
        {paragraphs.map((paragraph, index) => (
          <p class:list={['text-lg text-gray-700 leading-relaxed', index === paragraphs.length - 1 ? 'mb-8' : 'mb-6']}>
            {paragraph}
          </p>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <a href="/sr/contact/" class="bg-[#fcfbf9] rounded-[1.5rem] border border-gray-100 p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <h3 class="text-xl font-bold text-[#1a1a1a] mb-2">Kontakt i zakazivanje</h3>
          <p class="text-gray-600 leading-relaxed">Pitajte za dostupne termine, seanse uživo u Schaumburgu ili online seanse dok se fizički nalazite u Illinoisu.</p>
        </a>
        <a href="/sr/rates-and-insurance/" class="bg-[#fcfbf9] rounded-[1.5rem] border border-gray-100 p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <h3 class="text-xl font-bold text-[#1a1a1a] mb-2">Cene i osiguranje</h3>
          <p class="text-gray-600 leading-relaxed">Pogledajte informacije o osiguranju, privatnom plaćanju i praktičnim koracima pre početka.</p>
        </a>
      </div>
    </div>
  </div>
</section>
