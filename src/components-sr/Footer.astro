---
import { mapUrl } from '../utils-sr/seo';

const supportLinks = [
  { text: 'info@centerforpta.com', href: 'mailto:info@centerforpta.com' },
  { text: '(847) 230-0045 (Telefon)', href: 'tel:+18472300045' },
  { text: '(847) 929-7040 (SMS)', href: 'sms:+18479297040' }
];
const servicesLinks = [
  { text: 'Terapija', href: '/sr/therapy/' },
  { text: 'Psihološka procena', href: '/sr/psychological-assessment/' },
  { text: 'Imigracione evaluacije', href: '/sr/immigration-evaluations/' },
  { text: 'Konsultacije i koučing', href: '/sr/consultation-supervision-and-coaching/' }
];
const legalLinks = [{ text: 'Politika privatnosti', href: '/sr/privacy-policy/' }];
const socialLinks: Array<{ label: string; href: string }> = [];
---

<footer class="bg-white py-14 xl:py-16">
  <div class="max-w-[1440px] mx-auto px-5 md:px-10 xl:px-24">

    <!-- Main grid: stack on mobile, row on desktop -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-[1fr_1fr_1fr_auto] gap-8 xl:gap-12">

      <!-- Column 1: Ordering & Support -->
      <div class="flex flex-col gap-1">
        <h3 class="text-base xl:text-xl font-bold text-black py-2">Kontakt informacije</h3>
        {supportLinks.map((link) => (
          <a href={link.href} class="text-sm xl:text-lg text-black py-1 hover:text-[#2f594f] transition-colors font-medium">
            {link.text}
          </a>
        ))}
      </div>

      <!-- Column 2: Usluge -->
      <div class="flex flex-col gap-1">
        <h3 class="text-base xl:text-xl font-bold text-black py-2">Usluge</h3>
        {servicesLinks.map((link) => (
          <a href={link.href} class="text-sm xl:text-lg text-black py-1 hover:text-[#2f594f] transition-colors font-medium">
            {link.text}
          </a>
        ))}
      </div>

      <!-- Kolona 3: Lokalna ordinacija -->
      <div class="flex flex-col gap-1">
        <h3 class="py-2 text-base font-bold text-black xl:text-xl">Ordinacija u Schaumburgu</h3>
        <address class="text-sm font-medium not-italic leading-relaxed text-black xl:text-lg">
          Center for PTA<br />
          1320 Tower Rd, Suite 156<br />
          Schaumburg, IL 60173
        </address>
        <p class="py-1 text-sm font-medium leading-relaxed text-gray-600 xl:text-base">
          Ponedeljak-petak: 9:00-20:00<br />
          Subota-nedelja: zatvoreno
        </p>
        <p class="py-1 text-sm font-medium leading-relaxed text-gray-600 xl:text-base">
          Dostupni su pristupačan parking i toalet.<br />
          Zakazivanje se preporučuje.
        </p>
        <a
          href={mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="py-1 text-sm font-semibold text-[#2f594f] transition-colors hover:text-[#1f3f37] xl:text-base"
        >
          Otvorite u Google Maps
        </a>
        <a
          href="/sr/schaumburg-office/"
          class="py-1 text-sm font-semibold text-[#2f594f] transition-colors hover:text-[#1f3f37] xl:text-base"
        >
          Detalji o ordinaciji i FAQ o lokaciji
        </a>
      </div>

      <!-- Kolona 4: Kontakt forma -->
      <div class="flex flex-col gap-3 sm:col-span-2 xl:col-span-1 xl:w-[450px]">
        <h3 class="text-base xl:text-2xl font-bold text-black py-2 mb-2">Pošaljite poruku</h3>
        <form name="contact" method="POST" action="/sr/hvala/" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col gap-3">
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="form-source" value="footer-sr" />
          <p class="hidden">
            <label>Ne popunjavajte ovo polje ako ste čovek: <input name="bot-field" /></label>
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="w-full">
              <label class="sr-only" for="footer-sr-first-name">Ime</label>
              <input
                id="footer-sr-first-name"
                type="text"
                name="first-name"
                autocomplete="given-name"
                placeholder="Ime"
                required
                class="w-full bg-[#fcfbf9] border border-gray-200 h-10 xl:h-12 rounded-xl px-4 text-sm xl:text-base text-black placeholder:text-gray-500 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all"
              />
            </div>
            <div class="w-full">
              <label class="sr-only" for="footer-sr-last-name">Prezime</label>
              <input
                id="footer-sr-last-name"
                type="text"
                name="last-name"
                autocomplete="family-name"
                placeholder="Prezime"
                required
                class="w-full bg-[#fcfbf9] border border-gray-200 h-10 xl:h-12 rounded-xl px-4 text-sm xl:text-base text-black placeholder:text-gray-500 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all"
              />
            </div>
          </div>
          <label class="sr-only" for="footer-sr-email">Email adresa</label>
          <input
            id="footer-sr-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Email adresa"
            required
            class="w-full bg-[#fcfbf9] border border-gray-200 h-10 xl:h-12 rounded-xl px-4 text-sm xl:text-base text-black placeholder:text-gray-500 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all"
          />
          <label class="sr-only" for="footer-sr-message">Kako možemo da pomognemo?</label>
          <textarea
            id="footer-sr-message"
            name="message"
            autocomplete="off"
            placeholder="Kako možemo da pomognemo?"
            required
            rows="4"
            class="w-full bg-[#fcfbf9] border border-gray-200 rounded-xl px-4 py-3 text-sm xl:text-base text-black placeholder:text-gray-500 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all resize-none"
          ></textarea>
          <button 
            type="submit" 
            class="h-10 xl:h-12 mt-1 bg-[#2f594f] rounded-xl text-sm xl:text-base font-bold text-white hover:bg-[#1f3f37] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
          >
            Pošaljite poruku
          </button>
        </form>
      </div>

    </div>

    <!-- Social icons / Copyright -->
    <div class="mt-12 flex flex-col md:flex-row justify-between items-center border-t border-gray-100 pt-8 gap-4">
      <p class="text-sm font-medium text-gray-500 text-center md:text-left">
        © {new Date().getFullYear()} Center for PTA. Sva prava zadržana.
      </p>
      <div class="flex items-center gap-5 xl:gap-6">
        {legalLinks.map((link) => (
          <a href={link.href} class="text-sm font-semibold text-[#2f594f] hover:text-[#1f3f37] transition-colors">
            {link.text}
          </a>
        ))}
        {socialLinks.length > 0 && (
          <>
          {socialLinks.map((link) => (
            <a href={link.href} class="text-sm font-semibold text-[#2f594f] hover:text-[#1f3f37] transition-colors">
              {link.label}
            </a>
          ))}
          </>
        )}
      </div>
    </div>

  </div>
</footer>
