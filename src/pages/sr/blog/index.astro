---
import InsightsListing from '../../../components-sr/InsightsListing.astro';

const postsPerPage = 6;
const allPosts = Object.values(import.meta.glob('./*.md', { eager: true })) as Array<{
  frontmatter: {
    date: string;
    title: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    category?: string;
  };
  url: string;
}>;

const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf();
});
const totalPages = Math.max(1, Math.ceil(sortedPosts.length / postsPerPage));
const posts = sortedPosts.slice(0, postsPerPage);
---

<InsightsListing posts={posts} currentPage={1} totalPages={totalPages} totalPosts={sortedPosts.length} />
