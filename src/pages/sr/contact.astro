---
import Layout from '../../layouts-sr/Layout.astro';
import Navbar from '../../components-sr/Navbar.astro';
import Footer from '../../components-sr/Footer.astro';
import FaqSection from '../../components-sr/FaqSection.astro';
import PageBreadcrumbs from '../../components/PageBreadcrumbs.astro';
import { absoluteUrl, mapUrl, providerLicenseNumber, siteUrl, textPhone } from '../../utils-sr/seo';
import { serbianLocalFaqItems } from '../../utils/local-practice-data.js';

const pageDescription =
  'Kontaktirajte dr Jelenu Djurovic u Šamburgu za terapiju, psihološko testiranje, imigracione i predoperativne evaluacije ili telehealth u Ilinoisu.';

const faqItems = [
  ...serbianLocalFaqItems,
  {
    question: 'Mogu li ovde da pitam o terapiji, testiranju ili evaluacijama?',
    answer:
      'Da. Možete pitati o terapiji, psihološkom testiranju, imigracionim psihološkim evaluacijama, predoperativnim ili barijatrijskim evaluacijama, prenatalnoj i postpartalnoj terapiji i drugim uslugama ordinacije.'
  },
  {
    question: 'Da li se kontakt forma Center for PTA prati za hitne slučajeve?',
    answer:
      'Ne. Forma je namenjena opštim pitanjima i upitima za termin i ne prati se radi hitnog odgovora. Ako ste u neposrednoj opasnosti ili ne možete da ostanete bezbedni, pozovite 911, pozovite ili pošaljite SMS na 988 u Sjedinjenim Državama ili idite u najbližu urgentnu službu.'
  }
];

const contactStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${absoluteUrl('/sr/contact/')}#webpage`,
  name: 'Kontakt Center for PTA',
  url: absoluteUrl('/sr/contact/'),
  description: pageDescription,
  inLanguage: 'sr-Latn',
  isPartOf: {
    '@id': `${siteUrl}/#website`
  },
  about: {
    '@id': `${siteUrl}/#professional-service`
  },
  mainEntity: {
    '@id': `${siteUrl}/#professional-service`
  },
  publisher: {
    '@id': `${siteUrl}/#professional-service`
  }
};
---

<Layout
  title="Kontakt Center for PTA | Psiholog u Šamburgu"
  description={pageDescription}
  faqItems={faqItems}
  structuredData={contactStructuredData}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#fcfbf9] overflow-hidden">
    <div class="absolute top-[20%] left-[-10%] w-[40%] h-[60%] bg-[#e0eae5] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="absolute bottom-[20%] right-[-10%] w-[30%] h-[50%] bg-[#fdf3df] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <PageBreadcrumbs
        currentLabel="Kontaktirajte Center for PTA"
        homeLabel="Početna"
        homePath="/sr/"
        ariaLabel="Putanja stranice"
        align="center"
      />
      <h1 class="text-4xl md:text-6xl xl:text-[72px] font-extrabold text-[#1a1a1a] leading-tight tracking-tight mb-8">
        Kontaktirajte psihologa u Schaumburgu, IL
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
        Javite se da pitate o terapiji, psihološkim evaluacijama, dolasku u ordinaciju u Schaumburgu ili online seansi kada se fizički nalazite u Ilinoisu.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm md:text-base font-semibold text-[#1a1a1a]">
        <span class="rounded-full bg-white px-4 py-2 border border-gray-100">Ordinacija u Schaumburgu</span>
        <span class="rounded-full bg-white px-4 py-2 border border-gray-100">Online uz fizičku lokaciju u Ilinoisu</span>
        <span class="rounded-full bg-white px-4 py-2 border border-gray-100">Srpski i engleski</span>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="flex flex-col lg:flex-row gap-12 xl:gap-20">
        
        <!-- Contact Info Cards -->
        <div class="lg:w-1/2 space-y-6">
          <div class="bg-[#fcfbf9] rounded-[2rem] p-8 md:p-10 border border-gray-100 flex items-start gap-6 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center shadow-sm text-[#147b6a] flex-shrink-0">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <p class="text-sm text-gray-500 font-bold uppercase tracking-wider mb-2">Telefon / SMS</p>
              <a href="tel:+18472300045" class="block text-2xl md:text-3xl font-extrabold text-[#1a1a1a] hover:text-[#2f594f] transition-colors">(847) 230-0045</a>
              <p class="text-gray-600 mt-2 font-medium">Fax: (847) 874-6273</p>
              <a href={`sms:${textPhone}`} class="block text-gray-600 mt-1 font-medium hover:text-[#2f594f] transition-colors">SMS: (847) 929-7040</a>
            </div>
          </div>

          <div class="bg-[#fcfbf9] rounded-[2rem] p-8 md:p-10 border border-gray-100 flex items-start gap-6 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center shadow-sm text-[#147b6a] flex-shrink-0">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <p class="text-sm text-gray-500 font-bold uppercase tracking-wider mb-2">Email</p>
              <a href="mailto:info@centerforpta.com" class="block text-xl md:text-2xl font-extrabold text-[#1a1a1a] hover:text-[#2f594f] transition-colors break-all">info@centerforpta.com</a>
            </div>
          </div>

          <div class="bg-[#d1f3f1] rounded-[2rem] p-8 md:p-10 border border-[#b8d6c9] flex items-start gap-6 shadow-sm">
            <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center shadow-sm text-[#147b6a] flex-shrink-0">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <p class="text-sm text-[#147b6a] font-bold uppercase tracking-wider mb-2">Naša ordinacija</p>
              <p class="text-xl md:text-2xl font-extrabold text-[#1a1a1a] mb-2 leading-tight">1320 Tower Rd, Suite 156<br />Schaumburg, IL 60173</p>
              <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-base font-bold text-[#0d5c4e] hover:text-[#2f594f] transition-colors mb-3">
                Otvorite mapu i putanju <span aria-hidden="true">&rarr;</span>
              </a>
              <a href="/sr/schaumburg-office/" class="block text-base font-bold text-[#0d5c4e] hover:text-[#2f594f] transition-colors mb-3">
                Pogledajte detalje i česta pitanja o ordinaciji
              </a>
              <p class="text-sm md:text-base font-semibold text-[#0d5c4e] uppercase tracking-[0.16em]">Licenca Illinois #{providerLicenseNumber}</p>
            </div>
          </div>
        </div>

        <!-- Netlify Form -->
        <div class="lg:w-1/2">
          <div class="bg-white rounded-[2rem] p-8 md:p-12 shadow-[0_20px_60px_rgba(0,0,0,0.06)] border border-gray-100 h-full">
            <h2 class="text-3xl font-extrabold text-[#1a1a1a] mb-8">Pošaljite nam poruku</h2>
            <form name="contact" method="POST" action="/sr/hvala/?submitted=1" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col gap-5">
              <input type="hidden" name="form-name" value="contact" />
              <input type="hidden" name="form-source" value="contact-page-sr" />
              <p class="hidden">
                <label>Ne popunjavajte ovo polje ako ste čovek: <input name="bot-field" /></label>
              </p>
              <div class="flex flex-col sm:flex-row gap-5">
                <div class="w-full">
                  <label class="sr-only" for="contact-sr-first-name">Ime</label>
                  <input
                    id="contact-sr-first-name"
                    type="text"
                    name="first-name"
                    autocomplete="given-name"
                    placeholder="Ime *"
                    required
                    class="w-full bg-[#fcfbf9] border border-gray-200 h-14 rounded-2xl px-5 text-base text-black placeholder:text-gray-400 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all"
                  />
                </div>
                <div class="w-full">
                  <label class="sr-only" for="contact-sr-last-name">Prezime</label>
                  <input
                    id="contact-sr-last-name"
                    type="text"
                    name="last-name"
                    autocomplete="family-name"
                    placeholder="Prezime *"
                    required
                    class="w-full bg-[#fcfbf9] border border-gray-200 h-14 rounded-2xl px-5 text-base text-black placeholder:text-gray-400 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all"
                  />
                </div>
              </div>
              <label class="sr-only" for="contact-sr-email">Email adresa</label>
              <input
                id="contact-sr-email"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="Email adresa *"
                required
                class="w-full bg-[#fcfbf9] border border-gray-200 h-14 rounded-2xl px-5 text-base text-black placeholder:text-gray-400 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all"
              />
              <label class="sr-only" for="contact-sr-message">Kako možemo da pomognemo?</label>
              <textarea
                id="contact-sr-message"
                name="message"
                autocomplete="off"
                placeholder="Kako možemo da pomognemo? *"
                required
                rows="6"
                class="w-full bg-[#fcfbf9] border border-gray-200 rounded-2xl px-5 py-4 text-base text-black placeholder:text-gray-400 outline-none focus:ring-2 focus:ring-[#2f594f]/40 focus:border-[#2f594f] transition-all resize-none"
              ></textarea>
              <button 
                type="submit" 
                class="h-14 mt-4 bg-[#2f594f] rounded-2xl text-lg font-bold text-white hover:bg-[#1f3f37] hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
              >
                Pošaljite poruku
              </button>
              <p class="text-sm leading-relaxed text-gray-600">
                Ova forma se ne prati za hitne slučajeve. Ako ste u neposrednoj opasnosti ili ne možete da ostanete bezbedni, pozovite 911, pozovite ili pošaljite SMS na 988 ili idite u najbližu urgentnu službu.
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="py-16 xl:py-24 bg-[#fcfbf9] relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-[1.75rem] border border-gray-100 p-7">
          <h2 class="text-xl font-bold text-[#1a1a1a] mb-3">Za terapiju</h2>
          <p class="text-gray-700 leading-relaxed">
            Pitajte o individualnoj, partnerskoj, porodičnoj, prenatalnoj i postpartalnoj terapiji ili telehealth seansama u Ilinoisu.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm font-bold text-[#0d5c4e]">
            <a href="/sr/therapy/" class="hover:text-[#2f594f] hover:underline">Terapijske usluge</a>
            <a href="/sr/couples-therapy/" class="hover:text-[#2f594f] hover:underline">Partnerska terapija</a>
            <a href="/sr/womens-mental-health-therapy/" class="hover:text-[#2f594f] hover:underline">Mentalno zdravlje žena</a>
          </div>
        </div>
        <div class="bg-white rounded-[1.75rem] border border-gray-100 p-7">
          <h2 class="text-xl font-bold text-[#1a1a1a] mb-3">Za testiranje</h2>
          <p class="text-gray-700 leading-relaxed">
            Pitajte o psihološkom testiranju, dijagnostičkom razjašnjenju, kognitivnim teškoćama ili proceni za prilagođavanje.
          </p>
          <a href="/sr/psychological-assessment/" class="mt-4 inline-block text-sm font-bold text-[#0d5c4e] hover:text-[#2f594f] hover:underline">
            Psihološka procena
          </a>
        </div>
        <div class="bg-white rounded-[1.75rem] border border-gray-100 p-7">
          <h2 class="text-xl font-bold text-[#1a1a1a] mb-3">Za evaluacije</h2>
          <p class="text-gray-700 leading-relaxed">
            Pitajte o imigracionim, predoperativnim i barijatrijskim psihološkim evaluacijama, izveštajima i rokovima.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm font-bold text-[#0d5c4e]">
            <a href="/sr/immigration-evaluations/" class="hover:text-[#2f594f] hover:underline">Imigracione evaluacije</a>
            <a href="/sr/pre-surgical-psychological-evaluations/" class="hover:text-[#2f594f] hover:underline">Predoperativne evaluacije</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection
    title="Česta pitanja o kontaktu i zakazivanju"
    intro="Odgovori na česta pitanja o lokaciji, uslugama i prvom koraku."
    faqs={faqItems}
  />

  <Footer />
</Layout>
