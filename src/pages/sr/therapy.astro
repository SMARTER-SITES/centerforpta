---
import Layout from '../../layouts-sr/Layout.astro';
import Navbar from '../../components-sr/Navbar.astro';
import PageBreadcrumbs from '../../components/PageBreadcrumbs.astro';
import Footer from '../../components-sr/Footer.astro';
import FaqSection from '../../components-sr/FaqSection.astro';
import LocalServiceArea from '../../components-sr/LocalServiceArea.astro';
import AuthorBioBox from '../../components-sr/AuthorBioBox.astro';
import PageAddressCard from '../../components-sr/PageAddressCard.astro';
import { getServiceStructuredData } from '../../utils-sr/seo';

const concerns = [
  { title: "Anksioznost i stres", desc: "Rad na brigama, paničnim napadima i stresu koji ometaju san, posao ili svakodnevne obaveze." },
  { title: "Depresija i raspoloženje", desc: "Razgovor o sniženom raspoloženju, gubitku interesovanja i teškoćama da se pokrenete." },
  { title: "Trauma i PTSP", desc: "Terapija se može baviti posledicama traumatskog iskustva, uz dogovor o tome šta ste spremni da otvorite u razgovoru." },
  { title: "Odnosi", desc: "Razgovor o sukobima, nepoverenju i teškoćama da kažete šta vam je potrebno u odnosu." },
  { title: "Životne promene", desc: "Podrška posle gubitka ili razdvajanja, pri promeni posla i drugim promenama na koje se teško navikavate." },
  { title: "Upotreba supstanci", desc: "Razgovor o upotrebi alkohola ili droga, posledicama koje primećujete i odgovarajućoj vrsti pomoći." },
  { title: "Samokritika", desc: "Rad na strogim zahtevima prema sebi, osećaju krivice i preispitivanju koje se stalno vraća na iste greške." },
  { title: "Hronični bol i bolest", desc: "Psihološka podrška kada bol ili bolest utiču na raspoloženje, odnose i svakodnevni život." }
];

const relatedLinks = [
  {
    href: '/sr/rates-and-insurance/',
    title: 'Cene i osiguranje',
    desc: 'Informacije o ceni seanse, osiguranju i privatnom plaćanju.'
  },
  {
    href: '/sr/contact/',
    title: 'Pošaljite upit za konsultaciju',
    desc: 'Javite se da pitate za individualnu, partnersku, porodičnu ili onlajn terapiju u Ilinoisu.'
  },
  {
    href: '/sr/psychological-assessment/',
    title: 'Psihološka procena',
    desc: 'Pogledajte testiranje za ADHD, autizam, dijagnostičko razjašnjenje i školska ili radna prilagođavanja.'
  },
  {
    href: '/sr/blog/2026-03-01-why-seek-psychotherapy/',
    title: 'Zašto potražiti psihoterapiju?',
    desc: 'O razlozima za javljanje psihologu i pitanjima koja se često javljaju pre prvog razgovora.'
  },
  {
    href: '/sr/blog/2026-03-02-how-do-i-find-the-right-therapist/',
    title: 'Kako da pronađem odgovarajućeg terapeuta?',
    desc: 'Šta da pitate o iskustvu terapeuta i načinu rada pre nego što zakažete.'
  },
  {
    href: '/sr/blog/why-am-i-so-hard-on-myself/',
    title: 'Zašto sam tako strog prema sebi?',
    desc: 'O tome odakle dolazi stroga samokritika i kako se može raditi na odnosu prema sebi.'
  }
];

const specialtyLinks = [
  {
    href: '/sr/couples-therapy/',
    title: 'Partnerska terapija',
    desc: 'Savetovanje za komunikaciju, konflikte koji se ponavljaju, poverenje i emocionalnu udaljenost.'
  },
  {
    href: '/sr/womens-mental-health-therapy/',
    title: "Terapija za mentalno zdravlje žena",
    desc: 'Razgovori o lečenju neplodnosti, trudnoći, odnosu prema telu i drugim brigama.'
  },
  {
    href: '/sr/self-compassion-therapy/',
    title: 'Terapija samosaosećanja',
    desc: 'Rad na oštroj samokritici, stidu, perfekcionizmu i iscrpljenosti.'
  },
  {
    href: '/sr/weight-loss-counseling/',
    title: 'Savetovanje za mršavljenje',
    desc: 'Rad na emocionalnom jedenju, odnosu prema telu i navikama u ishrani.'
  },
  {
    href: '/sr/bariatric-surgery-counseling/',
    title: 'Barijatrijsko savetovanje',
    desc: 'Emocionalna podrška pre i posle barijatrijske operacije.'
  },
  {
    href: '/sr/divorce-counseling/',
    title: 'Savetovanje tokom razvoda',
    desc: 'Razgovori o razdvajanju, razvodu i odnosima koji se time menjaju.'
  },
  {
    href: '/sr/prenatal-therapy/',
    title: 'Prenatalna terapija',
    desc: 'Terapijska podrška tokom trudnoće za stres, anksioznost i emocionalno prilagođavanje.'
  },
  {
    href: '/sr/postpartum-therapy/',
    title: 'Postpartalna terapija',
    desc: 'Psihološka podrška za teškoće sa raspoloženjem i prilagođavanje posle porođaja.'
  }
];

const pageDescription =
  'Psiholog na srpskom za Čikago i okolinu. Dr Jelena Đurović, ordinacija u Schaumburgu i onlajn terapija za klijente koji se nalaze u Ilinoisu.';

const faqItems = [
  {
    question: 'Gde se održavaju terapijske seanse uživo?',
    answer:
      'Terapija uživo je dostupna u ordinaciji Center for PTA na adresi 1320 Tower Rd, Suite 156, Schaumburg, IL 60173. Ordinacija je dostupna iz Hoffman Estates, Arlington Heights, Palatine, Rolling Meadows i okolnih severozapadnih predgrađa.'
  },
  {
    question: 'Da li je online terapija dostupna van Ilinoisa?',
    answer:
      'Dr Jelena Đurović ima licencu za rad u Ilinoisu. Onlajn seanse su moguće kada su svi učesnici fizički u Ilinoisu i kada je takav rad klinički primeren.'
  },
  {
    question: 'Da li je terapija dostupna na srpskom i engleskom?',
    answer:
      'Da, dr Jelena Đurović radi na srpskom i engleskom. Kada se javite, navedite na kom jeziku želite da razgovarate i pitajte za slobodne termine.'
  },
  {
    question: 'Kako da znam da li mi je potrebna terapija ili psihološka procena?',
    answer:
      'Na terapiji se kroz razgovore bavite teškoćama i onim što biste želeli da promenite. Psihološka procena služi da se odgovori na određeno pitanje, na primer da se razjasni dijagnoza. Ako niste sigurni šta vam treba, opišite razlog javljanja ordinaciji.'
  }
];

const localSectionParagraphs = [
  'Dr Jelena Đurović pruža terapiju uživo u ordinaciji Center for PTA na adresi 1320 Tower Rd, Suite 156 u Schaumburgu. Ordinacija služi klijentima iz Schaumburga i okolnih severozapadnih predgrađa, uključujući Hoffman Estates, Arlington Heights, Palatine, Rolling Meadows, Elk Grove Village i Streamwood.',
  'Onlajn seanse su moguće kada su svi učesnici fizički u Ilinoisu i kada je takav rad klinički primeren. Terapijske usluge su dostupne na srpskom i engleskom jeziku.'
];

const serviceStructuredData = getServiceStructuredData({
  name: 'Terapija u Schaumburgu, IL',
  description: pageDescription,
  path: '/sr/therapy/',
  serviceType: 'Psihoterapija'
});
---

<Layout
  medicalContent={true}
  title="Psiholog na srpskom | Schaumburg i Čikago"
  description={pageDescription}
  faqItems={faqItems}
  structuredData={serviceStructuredData}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#fcfbf9] overflow-hidden">
    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#e0eae5] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <PageBreadcrumbs currentLabel="Terapija u Schaumburgu, IL" homeLabel="Početna" homePath="/sr/" ariaLabel="Putanja stranice" align="center" />
      <p class="text-[15px] xl:text-lg font-bold text-[#2f594f] uppercase tracking-widest mb-4">Naše usluge</p>
      <h1 class="text-4xl md:text-5xl xl:text-[64px] font-extrabold text-[#1a1a1a] leading-tight tracking-tight mb-8">
        Psiholog na srpskom za Čikago i okolinu
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
        Ordinacija dr Jelene Đurović nalazi se u Schaumburgu. Terapija je dostupna na srpskom i engleskom, uživo ili onlajn kada su svi učesnici fizički u Ilinoisu i kada je takav rad klinički primeren.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-[1000px] mx-auto px-5 md:px-10">
      <h2 class="text-3xl font-bold text-[#2f594f] mb-5">Razgovor na jeziku koji vam odgovara</h2>
      <p class="text-lg leading-relaxed text-gray-700 mb-5">Ako vam je lakše da o porodici, odnosima ili teškom iskustvu govorite na srpskom, recite to kada se javite. Dr Jelena radi i sa osobama koje prolaze kroz lečenje neplodnosti, bore se sa strogom samokritikom ili razmišljaju o razvodu.</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-6">Adresa ordinacije je 1320 Tower Rd, Suite 156, Schaumburg, IL 60173. Ako vam dolazak ne odgovara, pitajte da li su onlajn seanse moguće za vas.</p>
      <div class="flex flex-wrap gap-5 text-[#2f594f] font-semibold">
        <a class="underline underline-offset-4" href="/sr/womens-mental-health-therapy/">Mentalno zdravlje žena</a>
        <a class="underline underline-offset-4" href="/sr/self-compassion-therapy/">Samosaosećanje</a>
        <a class="underline underline-offset-4" href="/sr/divorce-counseling/">Podrška tokom razvoda</a>
        <a class="underline underline-offset-4" href="/sr/contact/">Pitajte za termin</a>
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="flex flex-col md:flex-row gap-12 items-center">
        <div class="md:w-1/2">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a] mb-6">Kako počinje terapija</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-6">
            Prvi razgovori služe da dr Jelena upozna razlog vašeg dolaska, kako teškoće utiču na svakodnevni život i šta biste želeli da se promeni. Nije potrebno da unapred znate kako da objasnite sve što vam se dešava.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed">
            Zajedno dogovarate na čemu ćete raditi. Tokom terapije razgovarate i o tome da li vam rad pomaže i da li treba nešto promeniti u pristupu.
          </p>
        </div>
        <div class="md:w-1/2 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Individualna terapija</h3>
            <p class="text-gray-600">Razgovori sa psihologom o teškoćama zbog kojih dolazite i njihovom uticaju na vaš život.</p>
          </div>
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Partnerska terapija</h3>
            <p class="text-gray-600">Zajednički razgovori o sukobima, poverenju i problemima koje teško rešavate sami.</p>
          </div>
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Porodična terapija</h3>
            <p class="text-gray-600">Razgovori sa članovima porodice o odnosima i sukobima koji ih opterećuju.</p>
          </div>
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Onlajn terapija</h3>
            <p class="text-gray-600">Onlajn razgovori, kada su klinički primereni i svi učesnici se tokom seanse fizički nalaze u Ilinoisu.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sa čime radimo Section -->
  <section class="py-16 xl:py-24 bg-[#fcfbf9] relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">Sa čime radimo</h2>
        <p class="text-lg text-gray-700">Ovo su neki od razloga zbog kojih se ljudi javljaju za terapiju.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8">
        {concerns.map(concern => (
          <div class="bg-white p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{concern.title}</h3>
            <p class="text-[15px] text-gray-600 leading-relaxed">{concern.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">Više o pojedinim uslugama</h2>
        <p class="text-lg text-gray-700">
          Na ovim stranicama možete pročitati kako izgleda rad na problemu zbog kog se javljate.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {specialtyLinks.map((link) => (
          <a href={link.href} class="bg-[#fcfbf9] p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{link.title}</h3>
            <p class="text-gray-600 leading-relaxed">{link.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">Pre zakazivanja</h2>
        <p class="text-lg text-gray-700">
          Proverite cenu i osiguranje ili pročitajte više o izboru terapeuta i psihološkoj proceni.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedLinks.map((link) => (
          <a href={link.href} class="bg-[#fcfbf9] p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{link.title}</h3>
            <p class="text-gray-600 leading-relaxed">{link.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LocalServiceArea
    serviceName="Psihoterapija"
    title="Terapija u Schaumburgu i onlajn podrška u Ilinoisu"
    paragraphs={localSectionParagraphs}
  />

  <FaqSection
    title="Česta pitanja o terapiji u Schaumburgu"
    intro="Praktični odgovori o ordinaciji, granicama onlajn terapije, jezicima i izboru odgovarajuće usluge."
    faqs={faqItems}
  />

  <AuthorBioBox />
  <PageAddressCard />

  <!-- CTA section -->
  <section class="py-20 md:py-28 bg-[#2f594f] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-[#3a6e62] rounded-full blur-3xl opacity-50 -translate-y-1/2 translate-x-1/2"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 md:mb-8 tracking-tight">Javite se za termin</h2>
      <a href="/sr/contact/" class="inline-flex items-center justify-center px-8 md:px-12 py-4 bg-[#fcc13e] text-[#1a1a1a] text-lg font-bold rounded-full hover:bg-white hover:text-[#2f594f] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        Kontakt
      </a>
    </div>
  </section>

  <Footer />
</Layout>
