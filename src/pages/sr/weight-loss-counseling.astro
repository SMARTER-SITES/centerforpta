---
import Layout from '../../layouts-sr/Layout.astro';
import Navbar from '../../components-sr/Navbar.astro';
import Footer from '../../components-sr/Footer.astro';
import FaqSection from '../../components-sr/FaqSection.astro';
import LocalServiceArea from '../../components-sr/LocalServiceArea.astro';
import TopicHero from '../../components-sr/TopicHero.astro';
import TopicOverviewSection from '../../components-sr/TopicOverviewSection.astro';
import TopicProcessSection from '../../components-sr/TopicProcessSection.astro';
import AuthorBioBox from '../../components-sr/AuthorBioBox.astro';
import PageAddressCard from '../../components-sr/PageAddressCard.astro';
import { getServiceStructuredData } from '../../utils-sr/seo';

const topics = [
  {
    title: "Obrasci emocionalnog jedenja",
    desc: "Razumite kako stres, usamljenost, stid ili iscrpljenost mogu oblikovati obrasce ishrane i otežavati održivu promenu."
  },
  {
    title: "Slika tela i motivacija",
    desc: "Radite kroz obeshrabrenost, poređenje i sve-ili-ništa razmišljanje kako bi napredak bio realniji i manje kažnjavajući."
  },
  {
    title: "Podrška za promenu ponašanja",
    desc: "Terapija može podržati emocionalnu stranu doslednosti, zastoja, rutina i motivacije, uz razvoj praktičnih alata za nošenje."
  },
  {
    title: "Dugoročno mentalno zdravlje",
    desc: "Fokus nije samo na rezultatu težine, već i na smanjenju stida, jačanju poverenja u sebe i zdravijem svakodnevnom funkcionisanju."
  }
];

const relatedLinks = [
  {
    href: '/sr/bariatric-surgery-counseling',
    title: 'Barijatrijsko savetovanje',
    desc: 'Emocionalna podrška pre ili posle barijatrijske operacije i tokom prilagođavanja životnom stilu.'
  },
  {
    href: '/sr/pre-surgical-psychological-evaluations',
    title: 'Predoperativne evaluacije',
    desc: 'Psihološke evaluacije za odobrenje barijatrijskih i drugih medicinskih procedura.'
  },
  {
    href: '/sr/contact',
    title: 'Zakažite konsultaciju',
    desc: 'Pitajte za savetovanje u Schaumburgu ili online širom Illinoisa.'
  }
];

const signals = ['Uživo u Schaumburgu', 'Online širom Illinoisa', 'Podrška za sliku tela i emocionalno jedenje'];
const featureCards = [
  {
    title: 'Lokalna podrška',
    desc: 'Seanse uživo u Schaumburgu, u privatnom prostoru bez osuđivanja.'
  },
  {
    title: 'Celovit pristup',
    desc: 'Bavi se emocionalnim pokretačima obrazaca ishrane, ne samo samim ponašanjem.'
  },
  {
    title: 'Fleksibilan format',
    desc: 'Online širom Illinoisa za klijente kojima treba kontinuirana podrška bez dodavanja još jedne obaveze u nedelju.'
  }
];

const careStyle = [
  {
    title: 'Toplo i bez osuđivanja',
    desc: 'Za osobe koje su umorne od stida u vezi sa hranom ili telom. Bez merenja, bez predavanja.'
  },
  {
    title: 'Usmereno na obrasce ponašanja',
    desc: 'Gleda emocionalne obrasce iza nedoslednosti, umesto da motivaciju svodi na problem volje.'
  },
  {
    title: 'Perspektiva cele osobe',
    desc: 'Korisno kada su hrana, anksioznost, slika tela, samovrednovanje i životni stres isprepletani i treba im pristupiti kao sistemu.'
  }
];

const overviewParagraphs = [
  'Ovo savetovanje je za ljude koji već znaju šta bi trebalo da rade, ali stres, emocije ili samokritika stalno prekidaju doslednost. Fokus je na tome šta zaista stoji na putu, a ne na još jednom skupu pravila.',
  'Savetovanje za mršavljenje fokusira se na emocionalne i psihološke faktore koji utiču na promenu ponašanja, kako bi napredak bio održiviji i manje vođen krivicom.',
  'Mnogi ljudi već znaju šta bi trebalo da rade, ali uvid sam po sebi ne prelazi uvek u promenu. Stres, stid, perfekcionizam, istorija traume i težak odnos prema hrani ili slici tela mogu otežati doslednost čak i kada je motivacija snažna.'
];

const processParagraphs = [
  'Ovaj rad nije o osuđivanju, brzinskim dijetama ili pojednostavljenim savetima. Radi se o razumevanju uloge misli, osećanja, istorije, navika i stresa u procesu promene, a zatim o građenju stabilnijeg i saosećajnijeg pristupa.',
  'Terapija može biti posebno korisna kada se brige oko težine preklapaju sa anksioznošću, depresijom, stresom oko slike tela ili brigom pre i posle barijatrijske operacije.'
];

const processSteps = [
  {
    title: 'Prepoznajte emocionalni ciklus',
    desc: 'Istražite kako stres, usamljenost, stid i sve-ili-ništa razmišljanje oblikuju ishranu i motivaciju.'
  },
  {
    title: 'Smanjite stid i reaktivnost',
    desc: 'Stvorite više prostora između teških osećanja i impulsivnih ili obeshrabrujućih navika.'
  },
  {
    title: 'Podržite stabilniju promenu',
    desc: 'Gradite rutine i strategije nošenja koje su realnije, humanije i lakše za održavanje.'
  }
];

const pageDescription =
  'Savetovanje za mršavljenje u Schaumburgu, IL uz online seanse širom Illinoisa za emocionalno jedenje, sliku tela, promenu ponašanja, motivaciju i zdraviji odnos prema hrani i sebi.';

const faqItems = [
  {
    question: 'U čemu može pomoći savetovanje za mršavljenje?',
    answer:
      'Savetovanje za mršavljenje može pomoći kod emocionalnog jedenja, stida, sve-ili-ništa razmišljanja, oscilacija motivacije, problema sa slikom tela i emocionalne strane promene ponašanja.'
  },
  {
    question: 'Da li je savetovanje za mršavljenje dostupno u Schaumburgu i online u Illinoisu?',
    answer:
      'Da. Klijenti mogu dolaziti uživo u Schaumburg, Illinois, ili raditi online iz bilo kog dela Illinoisa.'
  },
  {
    question: 'Mogu li raditi savetovanje online ako živim van Schaumburga?',
    answer:
      'Da. Online seanse su dostupne odraslima širom Illinoisa. Seanse uživo dostupne su u Schaumburgu, što je praktično i za klijente iz Hoffman Estates, Roselle, Hanover Park i Streamwood.'
  },
  {
    question: 'Da li je ovo isto što i barijatrijsko savetovanje?',
    answer:
      'Ne baš. Savetovanje za mršavljenje je šire i može se fokusirati na emocionalno jedenje, sliku tela i dugoročnu promenu ponašanja. Barijatrijsko savetovanje je specifičnije usmereno na prilagođavanje pre i posle operacije.'
  }
];

const serviceStructuredData = getServiceStructuredData({
  name: 'Savetovanje za mršavljenje',
  description: pageDescription,
  path: '/sr/weight-loss-counseling/',
  serviceType: 'Savetovanje za mršavljenje'
});
---

<Layout
  title="Savetovanje za mršavljenje u Schaumburgu, IL"
  description={pageDescription}
  faqItems={faqItems}
  structuredData={serviceStructuredData}
>
  <Navbar />
  <TopicHero
    title="Savetovanje za mršavljenje"
    accent="koje ide dublje od saveta"
    description="Savetodavna podrška za emocionalno jedenje, sliku tela, motivaciju, samokritiku i emocionalne uspone i padove koji često prate pokušaj trajne zdravstvene promene."
    imageAlt="Udobna ordinacija za terapiju u Schaumburgu"
    imageSrc="/images/weight-loss-counseling.jpg"
    fitText="podrška za trajnu promenu kada su stres, stid i hrana deo iste slike"
    fitDescription="Ovo savetovanje je za ljude koji već znaju šta bi trebalo da rade, ali stres, emocije ili samokritika stalno prekidaju doslednost. Fokus je na tome šta zaista stoji na putu, a ne na još jednom skupu pravila."
    signals={signals}
    careStyle={careStyle}
    featureCards={featureCards}
  />

  <TopicOverviewSection
    eyebrow="Više od snage volje"
    title="Zašto napredak može delovati teže nego što izgleda"
    paragraphs={overviewParagraphs}
    cards={topics}
  />

  <TopicProcessSection
    eyebrow="Kako savetovanje pomaže"
    title="Podrška koja poštuje celu osobu"
    paragraphs={processParagraphs}
    steps={processSteps}
  />

  <LocalServiceArea
    serviceName="Savetovanje za mršavljenje"
    title="Savetovanje za mršavljenje u Schaumburgu i okolini"
    paragraphs={[
      'Dr Jelena Djurovic pruža savetovanje za mršavljenje u ordinaciji u Schaumburgu, dostupnoj klijentima iz Hoffman Estates, Roselle, Hanover Park, Streamwood i okolnih mesta. Njeno razumevanje odnosa uma i tela i istraživanja samosaosećanja oblikuju pristup koji ide mnogo dalje od lista ponašanja.',
      'Online seanse su dostupne širom države za stanovnike Illinoisa. Ako razmišljate o barijatrijskoj operaciji, dostupna je i povezana, ali zasebna usluga.'
    ]}
  />

  <AuthorBioBox />
  <PageAddressCard />

  <FaqSection
    faqs={faqItems}
    intro="Ovi odgovori pojašnjavaju šta savetovanje može obuhvatiti i kako mu pristupiti lokalno."
  />

  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">Povezane stranice</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedLinks.map((link) => (
          <a href={link.href} class="bg-[#fcfbf9] p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{link.title}</h3>
            <p class="text-gray-600 leading-relaxed">{link.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 bg-[#2f594f] relative overflow-hidden">
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 md:mb-8 tracking-tight">Zaslužujete podršku koja ide dublje od saveta</h2>
      <a href="/sr/contact" class="inline-flex items-center justify-center px-8 md:px-12 py-4 bg-[#fcc13e] text-[#1a1a1a] text-lg font-bold rounded-full hover:bg-white hover:text-[#2f594f] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        Kontakt
      </a>
    </div>
  </section>

  <Footer />
</Layout>
