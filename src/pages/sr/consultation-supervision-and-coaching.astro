---
import Layout from '../../layouts-sr/Layout.astro';
import Navbar from '../../components-sr/Navbar.astro';
import PageBreadcrumbs from '../../components/PageBreadcrumbs.astro';
import Footer from '../../components-sr/Footer.astro';
import FaqSection from '../../components-sr/FaqSection.astro';
import AuthorBioBox from '../../components-sr/AuthorBioBox.astro';
import PageAddressCard from '../../components-sr/PageAddressCard.astro';
import { getServiceStructuredData } from '../../utils-sr/seo';

const services = [
  {
    title: "Klinička supervizija",
    desc: "Sakupljate kliničke sate i tražite supervizora? Nudimo strukturisanu kliničku superviziju za kliničare u razvoju. Pre početka proverite da li predloženi odnos supervizije i dokumentacija ispunjavaju zahteve vašeg licencnog odbora, poslodavca ili programa obuke.",
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
  },
  {
    title: "Profesionalne konsultacije",
    desc: "Počinjete rad sa specifičnom populacijom ili razmišljate o složenom dijagnostičkom pitanju? Strukturisane profesionalne konsultacije mogu podržati formulaciju slučaja, planiranje tretmana, etičko promišljanje i dalji razvoj veština.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  },
  {
    title: "Ispitni i karijerni koučing",
    desc: "Nedavno ste diplomirali, pripremate se za EPPP ili kao novi kliničar planirate sledeći profesionalni korak? Koučing može pružiti strukturu učenja, strategije pripreme, podršku u odlučivanju i planiranju karijere, bez obećanja određenog ispitnog ili poslovnog ishoda.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  }
];

const pageDescription =
  'Klinička supervizija, profesionalne konsultacije, EPPP priprema i karijerni koučing kroz Center for PTA u Schaumburgu, Illinois.';

const faqItems = [
  {
    question: 'Koja je razlika između kliničke supervizije, profesionalnih konsultacija i koučinga?',
    answer:
      'Klinička supervizija je usmerena na profesionalni razvoj, razmatranje slučajeva, etiku i dogovorenu dokumentaciju u okviru supervizijskog odnosa. Profesionalne konsultacije pružaju fokusiran kolegijalni uvid za kliničko ili praktično pitanje. EPPP i karijerni koučing usmereni su na strukturu učenja, odlučivanje i profesionalno planiranje.'
  },
  {
    question: 'Ko pruža konsultacije, superviziju i koučing u Center for PTA?',
    answer:
      'Dr Jelena Djurovic, Psy.D., licencirani je klinički psiholog u državi Illinois sa više od 10 godina kliničkog iskustva. Uklapanje, domen rada, potrebe za dokumentacijom i trenutna dostupnost razmatraju se pre početka usluge.'
  },
  {
    question: 'Gde se nalazi Center for PTA i da li su dostupni online sastanci?',
    answer:
      'Center for PTA se nalazi na adresi 1320 Tower Rd, Suite 156, Schaumburg, IL 60173. Dostupnost sastanaka uživo, online ili u hibridnom formatu zavisi od tražene usluge, profesionalnih zahteva, uklapanja i rasporeda i treba je potvrditi direktno sa ordinacijom.'
  },
  {
    question: 'Da li se klinička supervizija računa za licencu ili obavezne kliničke sate?',
    answer:
      'Zahtevi se razlikuju prema licencnom odboru, profesiji, vrsti licence, programu obuke i jurisdikciji. Center for PTA ne može da odredi da li će određeni odbor ili program prihvatiti sate. Potvrdite zahteve sa nadležnim odborom ili programom i razgovarajte o predloženoj superviziji i dokumentaciji pre početka.'
  },
  {
    question: 'Da li su profesionalne usluge dostupne na srpskom i engleskom?',
    answer:
      'Da. Profesionalne usluge dostupne su na srpskom i engleskom jeziku. Kontaktirajte Center for PTA da potvrdite konkretnu uslugu, jezik, uklapanje i trenutnu dostupnost.'
  },
  {
    question: 'Da li profesionalne konsultacije ili koučing zamenjuju terapiju ili hitnu podršku?',
    answer:
      'Ne. Profesionalne konsultacije, klinička supervizija i ispitni ili karijerni koučing razlikuju se od psihoterapije i ne zamenjuju medicinsku negu, pravni savet niti hitne i krizne službe.'
  }
];

const serviceStructuredData = getServiceStructuredData({
  name: 'Konsultacije, supervizija i koučing',
  description: pageDescription,
  path: '/sr/consultation-supervision-and-coaching/',
  serviceType: 'Klinička supervizija i konsultacije'
});
---

<Layout
  title="Klinička supervizija u Schaumburgu | Center for PTA"
  description={pageDescription}
  faqItems={faqItems}
  structuredData={serviceStructuredData}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#fcfbf9] overflow-hidden">
    <div class="absolute top-[20%] right-[-10%] w-[40%] h-[60%] bg-[#fdf3df] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <PageBreadcrumbs currentLabel="Klinička supervizija, konsultacije i koučing u Schaumburgu" homeLabel="Početna" homePath="/sr/" ariaLabel="Putanja stranice" align="center" />
      <p class="text-[15px] xl:text-lg font-bold text-[#2f594f] uppercase tracking-widest mb-4">Naše usluge</p>
      <h1 class="text-4xl md:text-5xl xl:text-[64px] font-extrabold text-[#1a1a1a] leading-tight tracking-tight mb-8">
        Klinička supervizija, konsultacije i koučing u Schaumburgu
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
        Strukturisana profesionalna podrška za kliničare, EPPP kandidate i stručnjake za mentalno zdravlje koji planiraju sledeći korak.
      </p>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a] mb-6">Stručno vođenje za profesionalce u mentalnom zdravlju</h2>
        <p class="text-lg text-gray-700">
          Bilo da tek započinjete kliničku obuku ili želite da proširite specijalizovanu ekspertizu, naše mentorstvo i supervizija osmišljeni su da unaprede vašu kliničku praksu.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <div class="bg-[#fcfbf9] border border-gray-100 p-8 xl:p-10 rounded-[2rem] hover:shadow-xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-14 h-14 bg-[#147b6a] rounded-2xl flex items-center justify-center mb-8 shadow-md">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon}></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-[#1a1a1a] mb-4">{service.title}</h3>
            <p class="text-[16px] text-gray-600 leading-relaxed">{service.desc}</p>
          </div>
        ))}
      </div>
      
      <div class="mt-20 text-center bg-[#e0eae5] p-10 rounded-[2rem] border border-[#b8d6c9]">
        <h3 class="text-2xl md:text-3xl font-bold text-[#1a1a1a] mb-4">Napravite sledeći korak u karijeri</h3>
        <p class="text-lg text-[#2f594f] max-w-2xl mx-auto">Pozovite nas i saznajte kako možemo da vam pomognemo da sigurnije ostvarite profesionalne ciljeve.</p>
      </div>
    </div>
  </section>

  <FaqSection
    title="Česta pitanja o kliničkoj superviziji i konsultacijama"
    intro="Praktični odgovori o profesionalnom uklapanju, lokaciji, jezicima, dokumentaciji i licencnim zahtevima."
    faqs={faqItems}
  />

  <AuthorBioBox />

  <PageAddressCard />

  <!-- CTA section -->
  <section class="py-20 md:py-28 bg-[#2f594f] relative overflow-hidden">
    <div class="absolute bottom-[-20%] left-[20%] w-[30%] h-[30%] bg-[#f4e8e1] rounded-full opacity-20 blur-3xl"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 md:mb-8 tracking-tight">Spremni za napredak?</h2>
      <a href="/sr/contact/" class="inline-flex items-center justify-center px-8 md:px-12 py-4 bg-[#fcc13e] text-[#1a1a1a] text-lg font-bold rounded-full hover:bg-white hover:text-[#2f594f] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        Kontakt
      </a>
    </div>
  </section>

  <Footer />
</Layout>
