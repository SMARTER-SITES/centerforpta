---
import Layout from '../../layouts-sr/Layout.astro';
import Navbar from '../../components-sr/Navbar.astro';
import Footer from '../../components-sr/Footer.astro';
---

<Layout
  title="Poruka je poslata | Center for PTA"
  description="Vaša poruka je poslata ordinaciji Center for PTA u Šamburgu, Ilinois."
  noIndex={true}
  enAlternatePath={false}
>
  <Navbar alternatePath="/thank-you/" />

  <main class="min-h-[72vh] bg-[#fcfbf9] px-5 pb-20 pt-36 md:px-10 md:pb-28 md:pt-44">
    <div class="mx-auto max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#2f594f]">Poruka je primljena</p>
      <h1 class="mt-5 text-4xl font-extrabold leading-tight text-[#1a1a1a] md:text-6xl">
        Hvala što ste nam se javili.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-gray-700 md:text-xl">
        Vaša poruka je poslata ordinaciji Center for PTA. Pregledaćemo je i odgovoriti koristeći kontakt podatke koje ste naveli.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/sr/" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#2f594f] px-7 py-3 font-bold text-white hover:bg-[#24473f]">
          Nazad na početnu
        </a>
        <a href="tel:+18472300045" class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#2f594f] px-7 py-3 font-bold text-[#2f594f] hover:bg-white">
          Pozovite (847) 230-0045
        </a>
      </div>
    </div>
  </main>

  <Footer />

  <script is:inline>
    const leadEventKey = 'center-for-pta-contact-lead-sr';
    const confirmedSubmission = new URLSearchParams(window.location.search).get('submitted') === '1';
    if (confirmedSubmission && !sessionStorage.getItem(leadEventKey) && typeof window.gtag === 'function') {
      window.gtag('event', 'generate_lead', {
        form_name: 'contact',
        language: 'sr'
      });
      sessionStorage.setItem(leadEventKey, 'sent');
    }
  </script>
</Layout>
