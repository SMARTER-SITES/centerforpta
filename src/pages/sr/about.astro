---
import Layout from '../../layouts-sr/Layout.astro';
import Navbar from '../../components-sr/Navbar.astro';
import Footer from '../../components-sr/Footer.astro';
import { Image } from 'astro:assets';
import headshotImg from '../../assets/Jelena-Djurovic-headshot.png';
import { providerLicenseNumber } from '../../utils-sr/seo';

const conditions = [
  "Bračni problemi", "Zavisnost", "Anksioznost", "Depresija", "OCD", "ADHD", 
  "Problemi u komunikaciji", "Panični poremećaj", "Bipolarni poremećaj", "Šizofrenija", 
  "Social Anksioznost", "Poremećaj iz spektra autizma kod odraslih", "Trauma", 
  "Akulturacija i izolacija", "Kontrola besa", "Granični poremećaj ličnosti (BPD)", 
  "Kozavisnost", "Porodično nasilje", "Poremećaji ishrane", 
  "Savetovanje pre i posle barijatrijske operacije", "Slika tela", "Regulacija težine", 
  "Poremećaji kontrole impulsa", "Poremećaji raspoloženja", "Poremećaji ličnosti", 
  "Konflikti u odnosima", "Samopouzdanje", "Samopovređivanje", "Seksualno zlostavljanje", 
  "Sexual Zavisnost", "Životne promene", "Somatski poremećaji", "Suicidalne misli"
];

const whoWeTreat = [
  { title: "Pojedinci", desc: "Individualna terapija prilagođena vašim potrebama, ciljevima i životnom kontekstu." },
  { title: "Parovi", desc: "Podrška kroz izazove u odnosu, bolju komunikaciju i jačanje povezanosti sa partnerom." },
  { title: "Porodice", desc: "Rad na porodičnim obrascima, rešavanju konflikata i zdravijoj porodičnoj dinamici." }
];
---

<Layout
  title="O nama | Center for PTA"
  description="Saznajte više o dr Jeleni Djurovic i Center for PTA u Schaumburgu, IL, gde nudimo terapiju, evaluacije i individualizovanu podršku za uzrast 13+."
>
  
  <Navbar />

  <!-- About Hero -->
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-[#fcfbf9] overflow-hidden">
    <!-- Decorative elements from Hero for consistency -->
    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#e0eae5] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="absolute top-[20%] right-[-10%] w-[40%] h-[60%] bg-[#fdf3df] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <p class="text-[15px] xl:text-lg font-bold text-[#2f594f] uppercase tracking-widest mb-4">Ko smo mi</p>
      <h1 class="text-4xl md:text-6xl xl:text-[72px] font-extrabold text-[#1a1a1a] leading-tight tracking-tight mb-8">
        Savremena praksa za vaše potrebe u oblasti mentalnog zdravlja
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
        Nudimo psihoterapiju, psihološke procene i evaluacije za osobe od 13 godina naviše, za širok spektar potreba i životnih izazova.
      </p>
    </div>
  </section>

  <!-- Mission & Office details -->
  <section class="pb-16 xl:pb-24 bg-[#fcfbf9] relative">
    <div class="max-w-[1440px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="bg-[#d1f3f1] rounded-[2rem] md:rounded-[3rem] p-8 md:p-16 xl:p-20 relative overflow-hidden shadow-lg border border-[#c0ece9]">
        <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center">
          <svg class="w-12 h-12 md:w-16 md:h-16 text-[#147b6a] mb-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          <h2 class="text-2xl md:text-4xl lg:text-5xl font-extrabold text-[#147b6a] mb-6 md:mb-8 leading-tight tracking-tight">
            Udobna, moderna podrška, gde god da se nalazite.
          </h2>
          <p class="text-base md:text-xl text-[#0d5c4e] leading-relaxed mb-8 md:mb-10 font-medium">
            Bilo da želite da dođete u našu modernu, čistu i udobnu ordinaciju ili da dobijete podršku iz svog doma, tu smo da pomognemo.
          </p>
          <div class="inline-flex items-center gap-3 bg-white/70 px-5 md:px-7 py-3 md:py-4 rounded-full text-[#147b6a] font-bold text-xs md:text-sm shadow-sm">
            <svg class="w-5 h-5 text-[#fcc13e] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <span class="text-left leading-snug">Tražite terapeuta ili evaluatora za decu? Aktivno radimo na tome da dodamo ovu uslugu našem timu. Uskoro više informacija.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kome pomažemo -->
  <section class="py-16 xl:py-24 bg-white">
    <div class="max-w-[1440px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] tracking-tight">Kome pomažemo</h2>
        <div class="w-24 h-1 bg-[#fcc13e] mx-auto mt-6 rounded-full"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 xl:gap-10 max-w-[1200px] mx-auto">
        {whoWeTreat.map(item => (
          <div class="bg-[#fcfbf9] rounded-[2rem] p-8 xl:p-10 shadow-sm hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)] hover:-translate-y-2 transition-all duration-500 border border-gray-100 flex flex-col items-center text-center group">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center mb-6 text-[#2f594f] shadow-sm group-hover:bg-[#2f594f] group-hover:text-white transition-colors duration-500">
              {item.title === 'Pojedinci' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>}
              {item.title === 'Parovi' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>}
              {item.title === 'Porodice' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>}
            </div>
            <h3 class="text-2xl font-extrabold text-[#1a1a1a] mb-4">{item.title}</h3>
            <p class="text-[15px] md:text-base text-gray-600 leading-relaxed font-medium">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full Provider Bio -->
  <section class="bg-[#fcfbf9] py-16 xl:py-24 relative z-10">
    <div class="max-w-[1440px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="flex flex-col lg:flex-row items-start gap-12 xl:gap-20">

        <!-- Left: image -->
        <div class="w-full lg:flex-none lg:w-[450px] xl:w-[500px] h-[400px] sm:h-[500px] lg:h-[600px] rounded-[2.5rem] overflow-hidden shadow-2xl lg:sticky lg:top-32 border border-gray-100/50">
          <Image 
            src={headshotImg} 
            alt="Dr. Jelena Djurovic" 
            class="w-full h-full object-cover object-top" 
            format="webp"
            quality={85}
            widths={[400, 800]} 
            sizes="(max-width: 1024px) 100vw, 500px" 
          />
        </div>

        <!-- Right: content -->
        <div class="flex flex-col flex-1 pb-10">
          <p class="text-sm md:text-[15px] font-bold text-[#2f594f] uppercase tracking-widest leading-normal mb-3">Upoznajte svog terapeuta</p>

          <h2 class="text-3xl md:text-4xl xl:text-[48px] font-extrabold text-[#1a1a1a] xl:leading-snug tracking-tight">
            Dr. Jelena Djurovic, Psy.D.
          </h2>
          <p class="mt-4 text-sm md:text-base font-semibold uppercase tracking-[0.18em] text-[#2f594f]">
            Licencirani klinički psiholog u Illinoisu | Licenca #{providerLicenseNumber}
          </p>

          <div class="mt-8 flex flex-col gap-6 text-[17px] md:text-[19px] text-gray-700 leading-relaxed font-medium">
            <p>
              Dr Jelena Djurovic je licencirani klinički psiholog u državi Illinois sa više od 10 godina kliničke prakse, uključujući psihoterapiju i procenu osoba sa širokim spektrom psiholoških teškoća i različitim životnim iskustvima.
            </p>
            <p>
              Dr Djurovic je doktorirala kliničku psihologiju na The Chicago School of Professional Psychology. Njeno doktorsko istraživanje bilo je usmereno na odnos uma i tela, odnosno na to kako pozitivan odnos prema sebi može uticati na fizičko zdravlje i kako briga o fizičkom zdravlju može pomoći psihološkom blagostanju. Takođe je istraživala kako kratka obuka iz mindfulness veština može uticati na depresiju i kvalitet života. Master studije kliničke psihologije završila je na Illinois School of Professional Psychology. Ima iskustvo u radu sa osobama koje se suočavaju sa teškim i hroničnim mentalnim bolestima, zloupotrebom supstanci, porodičnim nasiljem, depresijom, anksioznošću, kompleksnom traumom, problemima slike tela, poremećajima ishrane, problemima u odnosima, kao i pitanjima vezanim za imigraciju i akulturaciju. Kao imigrantkinja, dr Djurovic razume mnoge emocionalne, praktične i pravne izazove koji mogu nastati preseljenjem u drugu zemlju. Srpski joj je maternji jezik, engleski govori tečno, a španski konverzacijski.
            </p>

            <h3 class="mt-8 mb-2 text-2xl md:text-3xl font-extrabold text-[#147b6a]">Pristup dr Djurovic terapiji</h3>

            <div class="mt-2 flex gap-5 md:gap-7 items-start bg-white p-6 md:p-8 rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.04)] border border-gray-50">
              <div class="w-2.5 min-w-[10px] h-auto bg-[#fcc13e] flex-none rounded-full self-stretch" />
              <p class="text-lg md:text-[22px] font-bold text-[#1a1a1a] leading-relaxed italic">
                "Verujem da u današnje vreme terapija nije luksuz, niti je namenjena isključivo osobama koje pate od mentalne bolesti, već je potreba i može biti korisna gotovo svakome u različitim životnim situacijama."
              </p>
            </div>

            <p class="mt-4">
              Tokom istorije, ljudsko telo se fiziološki nije mnogo promenilo u poslednjih nekoliko stotina godina. Međutim, naš način života se značajno promenio. Stres i anksioznost su svuda oko nas. Živimo veoma brzo i preuzimamo količinu odgovornosti i stimulacije koju je često teško nositi bez podrške brižnog, saosećajnog i objektivnog partnera. Zato moj pristup psihoterapiji podrazumeva partnerstvo između terapeuta i klijenta, kroz koje klijenti bolje upoznaju sebe, svoje potrebe i granice, i uče kako da uvedu korake koji im pomažu da izgrade život koji im više odgovara.
            </p>
            <p>
              Kroz rad sa različitim ljudima i različitim vrstama problema, primetila sam da se mnoge teškoće održavaju kroz negativan odnos prema sebi. Verujem da učenje zdravijeg i pozitivnijeg odnosa prema sebi može značajno poboljšati kvalitet života, bez obzira na to kako je taj odnos prvobitno nastao. Važno je naglasiti da samosaosećanje znači odnositi se prema sebi onako kako biste se odnosili prema najboljem prijatelju ili osobi do koje vam je duboko stalo.
            </p>
            <p>
              Moj pristup psihoterapiji je zasnovan na dokazima, empirijski podržan i oslonjen na savremena istraživanja. Koristim principe iz istraživanja dr Kristin Neff o samosaosećanju, kao i savremene mindfulness intervencije. Po potrebi uključujem principe AEDP pristupa (Accelerated Experiential Dynamic Psychotherapy), kao i kognitivno-bihejvioralne tehnike.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Stanja i teškoće sa kojima radimo -->
  <section class="py-20 xl:py-32 bg-white border-t border-gray-100 relative overflow-hidden">
    <!-- background accent shape -->
    <div class="absolute right-0 top-0 w-[600px] h-[600px] bg-[#fdf3df] rounded-full blur-[100px] opacity-30 -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute left-0 bottom-0 w-[500px] h-[500px] bg-[#e0eae5] rounded-full blur-[100px] opacity-40 translate-y-1/2 -translate-x-1/3"></div>

    <div class="max-w-[1200px] mx-auto px-5 md:px-10 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-extrabold text-[#1a1a1a] mb-6 tracking-tight">Stanja i teškoće sa kojima radimo</h2>
        <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto font-medium">
          Imamo široko iskustvo u podršci klijentima kroz različite životne teškoće i kliničke dijagnoze.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 md:gap-4 lg:gap-5">
        {conditions.map(condition => (
          <div class="px-5 md:px-6 py-3 bg-white border border-gray-200 text-gray-800 hover:border-[#2f594f] hover:bg-[#2f594f] hover:text-white shadow-sm hover:shadow-md transition-all duration-300 rounded-full text-sm md:text-[15px] font-bold cursor-default">
            {condition}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA section -->
  <section class="py-20 md:py-28 bg-[#2f594f] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-[#3a6e62] rounded-full blur-3xl opacity-50 -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-[#1f3f37] rounded-full blur-3xl opacity-50 translate-y-1/2 -translate-x-1/2"></div>
    
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 md:mb-8 tracking-tight">Spremni za prvi korak?</h2>
      <p class="text-lg md:text-xl text-[#d1f3f1] mb-10 max-w-2xl mx-auto font-medium">
        Javite se da zakažete termin ili konsultaciju. Tu smo da odgovorimo na pitanja i pomognemo vam da započnete sledeći korak.
      </p>
      <a href="/sr/contact" class="inline-flex items-center justify-center px-8 md:px-12 py-4 bg-[#fcc13e] text-[#1a1a1a] text-lg font-bold rounded-full hover:bg-white hover:text-[#2f594f] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        Kontakt
      </a>
    </div>
  </section>

  <Footer />
</Layout>
