---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import headshotImg from '../assets/Jelena-Djurovic-headshot.png';
import {
  providerLicenseNumber,
  providerNpiNumber,
  siteName,
  siteUrl
} from '../utils/seo';

const providerUrl = `${siteUrl}/dr-jelena-djurovic/`;
const providerImage = new URL(headshotImg.src, siteUrl).toString();

const providerStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${providerUrl}#person`,
  name: 'Dr. Jelena Djurovic',
  honorificPrefix: 'Dr.',
  honorificSuffix: 'Psy.D.',
  url: providerUrl,
  image: providerImage,
  jobTitle: 'Illinois Licensed Clinical Psychologist',
  description:
    'Dr. Jelena Djurovic is an Illinois Licensed Clinical Psychologist providing psychotherapy, psychological assessment, immigration evaluations, and pre-surgical evaluations in Schaumburg, Illinois.',
  worksFor: {
    '@id': `${siteUrl}/#professional-service`,
    name: siteName
  },
  identifier: [
    {
      '@type': 'PropertyValue',
      propertyID: 'Illinois Clinical Psychologist License',
      value: providerLicenseNumber
    },
    {
      '@type': 'PropertyValue',
      propertyID: 'National Provider Identifier',
      value: providerNpiNumber
    }
  ],
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'The Chicago School of Professional Psychology'
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'Illinois School of Professional Psychology'
    }
  ],
  knowsLanguage: ['English', 'Serbian'],
  knowsAbout: [
    'Psychotherapy',
    'Couples therapy',
    'Immigration psychological evaluations',
    'Pre-surgical psychological evaluations',
    'Bariatric psychological evaluations',
    "Women's mental health",
    'Self-compassion',
    'Psychological assessment'
  ],
  sameAs: [
    'https://www.psychologytoday.com/us/therapists/jelena-djurovic-schaumburg-il/1611370'
  ]
};

const focusAreas = [
  {
    title: 'Therapy',
    description:
      'Individual and couples therapy for anxiety, depression, trauma, relationships, self-compassion, body image, and major life transitions.',
    href: '/therapy/'
  },
  {
    title: 'Immigration evaluations',
    description:
      'Clinically grounded psychological evaluations for qualifying immigration matters, with attorney coordination when appropriate and authorized.',
    href: '/immigration-evaluations/'
  },
  {
    title: 'Pre-surgical evaluations',
    description:
      'Psychological evaluations for bariatric and other surgical programs, with clear clinical documentation for the referring medical team.',
    href: '/pre-surgical-psychological-evaluations/'
  },
  {
    title: 'Women’s mental health',
    description:
      'Support for reproductive concerns, prenatal and postpartum transitions, body image, relationships, and self-compassion.',
    href: '/womens-mental-health-therapy/'
  }
];
---

<Layout
  title="Dr. Jelena Djurovic, PsyD | Psychologist in Schaumburg, IL"
  description="Meet Dr. Jelena Djurovic, an Illinois Licensed Clinical Psychologist in Schaumburg providing therapy, psychological assessments, immigration evaluations, and pre-surgical evaluations."
  image={headshotImg.src}
  structuredData={providerStructuredData}
  srAlternatePath="/sr/dr-jelena-djurovic/"
>
  <Navbar />

  <main>
    <section class="relative min-h-[720px] flex items-end overflow-hidden bg-[#1a2824]">
      <Image
        src={headshotImg}
        alt="Dr. Jelena Djurovic, Illinois Licensed Clinical Psychologist"
        class="absolute inset-0 h-full w-full object-cover object-[55%_18%] md:object-[70%_20%]"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={88}
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-[#10201c]/70"></div>

      <div class="relative z-10 w-full px-5 pb-16 pt-40 md:px-10 md:pb-20 xl:px-24">
        <div class="mx-auto max-w-[1440px]">
          <div class="max-w-3xl">
            <p class="mb-5 text-sm font-bold uppercase tracking-[0.16em] text-[#f7c95e]">
              Meet your psychologist
            </p>
            <h1 class="text-4xl font-extrabold leading-tight text-white md:text-6xl xl:text-[76px]">
              Dr. Jelena Djurovic
            </h1>
            <p class="mt-5 text-xl font-semibold text-white md:text-2xl">
              Illinois Licensed Clinical Psychologist, Psy.D.
            </p>
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/85 md:text-xl">
              Psychotherapy, psychological assessment, immigration evaluations, and
              pre-surgical evaluations in Schaumburg, Illinois.
            </p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href="/contact/"
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#fcc13e] px-7 py-3 font-bold text-[#17231f] transition-transform hover:-translate-y-0.5"
              >
                Request a consultation
              </a>
              <a
                href="/therapy/"
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/50 px-7 py-3 font-bold text-white transition-colors hover:bg-white hover:text-[#17231f]"
              >
                Explore services
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto grid max-w-[1440px] grid-cols-1 px-5 py-8 sm:grid-cols-2 md:px-10 lg:grid-cols-4 xl:px-24">
        <div class="py-4 lg:pr-8">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">License</p>
          <p class="mt-2 text-lg font-bold text-[#1a1a1a]">Illinois #{providerLicenseNumber}</p>
        </div>
        <div class="border-gray-200 py-4 sm:border-l sm:pl-8">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">NPI</p>
          <p class="mt-2 text-lg font-bold text-[#1a1a1a]">{providerNpiNumber}</p>
        </div>
        <div class="border-gray-200 py-4 lg:border-l lg:pl-8">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Languages</p>
          <p class="mt-2 text-lg font-bold text-[#1a1a1a]">English and Serbian</p>
          <p class="mt-1 text-sm text-gray-600">Conversational Spanish</p>
        </div>
        <div class="border-gray-200 py-4 sm:border-l sm:pl-8">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gray-500">Location</p>
          <p class="mt-2 text-lg font-bold text-[#1a1a1a]">Schaumburg, Illinois</p>
        </div>
      </div>
    </section>

    <section class="bg-[#fcfbf9] py-16 md:py-24">
      <div class="mx-auto grid max-w-[1200px] gap-10 px-5 md:px-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#2f594f]">Background</p>
          <h2 class="mt-4 text-3xl font-extrabold leading-tight text-[#1a1a1a] md:text-5xl">
            Clinical care shaped by evidence, culture, and compassion
          </h2>
        </div>
        <div class="space-y-6 text-lg leading-relaxed text-gray-700">
          <p>
            Dr. Jelena Djurovic is an Illinois Licensed Clinical Psychologist with more
            than a decade of clinical experience in psychotherapy and psychological
            assessment with people from varied backgrounds.
          </p>
          <p>
            She earned her Doctorate in Clinical Psychology from The Chicago School of
            Professional Psychology and her master’s degree in Clinical Psychology from
            the Illinois School of Professional Psychology. Her doctoral work explored
            the mind-body relationship, self-compassion, mindfulness, depression, and
            quality of life.
          </p>
          <p>
            As an immigrant and native Serbian speaker, Dr. Djurovic brings personal
            understanding to the emotional, cultural, and practical challenges that can
            accompany immigration and acculturation. She is fluent in English, speaks
            Serbian natively, and has conversational proficiency in Spanish.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-[1200px] px-5 md:px-10">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#2f594f]">Areas of focus</p>
          <h2 class="mt-4 text-3xl font-extrabold text-[#1a1a1a] md:text-5xl">
            Specialized care with a clear path forward
          </h2>
        </div>

        <div class="mt-12 grid gap-0 border-y border-gray-200 md:grid-cols-2">
          {focusAreas.map((area, index) => (
            <a
              href={area.href}
              class:list={[
                'group block border-gray-200 py-8 transition-colors hover:bg-[#f7faf8] md:p-9',
                index % 2 === 1 ? 'md:border-l' : '',
                index > 1 ? 'border-t' : index > 0 ? 'border-t md:border-t-0' : ''
              ]}
            >
              <h3 class="text-2xl font-bold text-[#1a1a1a] group-hover:text-[#2f594f]">
                {area.title}
              </h3>
              <p class="mt-4 leading-relaxed text-gray-600">{area.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 font-bold text-[#2f594f]">
                Learn more
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#24483f] py-16 text-white md:py-24">
      <div class="mx-auto grid max-w-[1200px] gap-10 px-5 md:px-10 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#f7c95e]">Clinical approach</p>
          <h2 class="mt-4 text-3xl font-extrabold leading-tight md:text-5xl">
            A collaborative relationship grounded in respect
          </h2>
        </div>
        <div class="space-y-6 text-lg leading-relaxed text-white/85">
          <p>
            Dr. Djurovic views psychotherapy as a partnership. Her work helps clients
            understand themselves more clearly, build healthier boundaries, and develop
            a more supportive relationship with themselves.
          </p>
          <p>
            Her integrative approach draws from evidence-based and empirically supported
            methods, including self-compassion research, mindfulness-based interventions,
            AEDP, and cognitive-behavioral techniques when appropriate.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#fcfbf9] py-16 md:py-24">
      <div class="mx-auto max-w-[1200px] px-5 md:px-10">
        <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#2f594f]">Media and education</p>
            <h2 class="mt-4 text-3xl font-extrabold text-[#1a1a1a] md:text-5xl">
              Public conversations that extend clinical care
            </h2>
          </div>
          <div class="divide-y divide-gray-200 border-y border-gray-200">
            <a
              href="https://serbiantimes.info/srpkinja-psiholog-u-cikagu-od-cega-najvise-pate-nasi-ljudi-u-americi-i-kako-im-psiholog-moze-pomoci-da-dobiju-papire-video/"
              target="_blank"
              rel="noreferrer"
              class="group block py-7"
            >
              <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#2f594f]">Serbian Times</p>
              <h3 class="mt-3 text-xl font-bold text-[#1a1a1a] group-hover:text-[#2f594f]">
                Interview on immigrant mental health and psychological evaluations
              </h3>
            </a>
            <a
              href="https://www.youtube.com/watch?v=4xS8Sm2lOh4"
              target="_blank"
              rel="noreferrer"
              class="group block py-7"
            >
              <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#2f594f]">SBN Chicago News</p>
              <h3 class="mt-3 text-xl font-bold text-[#1a1a1a] group-hover:text-[#2f594f]">
                Nije Bitno Gde Sam Već Ko Sam — conversation with Dr. Jelena Djurovic
              </h3>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-[900px] px-5 text-center md:px-10">
        <h2 class="text-3xl font-extrabold text-[#1a1a1a] md:text-5xl">
          Ask whether Dr. Djurovic’s services fit your needs
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">
          Contact the practice about current availability, insurance, language needs,
          and the appropriate next step for therapy or evaluation.
        </p>
        <a
          href="/contact/"
          class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-[#2f594f] px-8 py-3 font-bold text-white transition-transform hover:-translate-y-0.5"
        >
          Contact the practice
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
