---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import PageBreadcrumbs from '../components/PageBreadcrumbs.astro';
import {
  englishLocalFaqItems,
  nearbyCommunities
} from '../utils/local-practice-data.js';
import { absoluteUrl, mapUrl, siteUrl } from '../utils/seo';

const pageTitle = 'Psychologist Office in Schaumburg, IL | Center for PTA';
const pageDescription =
  'Visit Center for PTA at 1320 Tower Rd, Suite 156 in Schaumburg, IL. See office hours, services, languages, access details, directions, and FAQs.';
const officePageUrl = absoluteUrl('/schaumburg-office/');

const officeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${officePageUrl}#webpage`,
  url: officePageUrl,
  name: pageTitle,
  description: pageDescription,
  inLanguage: 'en-US',
  isPartOf: {
    '@id': `${siteUrl}/#website`
  },
  about: {
    '@id': `${siteUrl}/#professional-service`
  },
  mainEntity: {
    '@id': `${siteUrl}/#professional-service`
  }
};

const officeServices = [
  {
    name: 'Individual, couples, and family therapy',
    description: 'Support for anxiety, depression, trauma, grief, relationships, self-compassion, reproductive stress, and life transitions.',
    path: '/therapy/'
  },
  {
    name: "Women's mental health therapy",
    description: 'Focused support for fertility-treatment stress, reproductive loss, pregnancy, postpartum adjustment, body image, and self-compassion.',
    path: '/womens-mental-health-therapy/'
  },
  {
    name: 'Psychological testing and assessment',
    description: 'Assessment selected around a defined referral question, current need, and appropriate evaluation format.',
    path: '/psychological-assessment/'
  },
  {
    name: 'Immigration psychological evaluations',
    description: 'Clinically grounded evaluations with attorney coordination when appropriate and authorized by the client.',
    path: '/immigration-evaluations/'
  },
  {
    name: 'Pre-surgical psychological evaluations',
    description: 'Evaluations for bariatric surgery and other procedures when a psychological evaluation is requested by the medical program.',
    path: '/pre-surgical-psychological-evaluations/'
  },
  {
    name: 'Bariatric and weight-related counseling',
    description: 'Therapeutic support for emotional eating, body image, behavior change, and adjustment before or after bariatric surgery.',
    path: '/bariatric-surgery-counseling/'
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqItems={englishLocalFaqItems}
  structuredData={officeStructuredData}
>
  <Navbar />

  <main>
    <section class="border-b border-gray-200 bg-[#fcfbf9] pb-16 pt-32 md:pb-20 md:pt-40">
      <div class="mx-auto max-w-[1100px] px-5 md:px-10 xl:px-24">
        <PageBreadcrumbs currentLabel="Schaumburg Office" />
        <p class="mb-4 text-sm font-bold uppercase text-[#2f594f]">Center for PTA location</p>
        <h1 class="max-w-4xl text-4xl font-extrabold leading-tight text-[#1a1a1a] md:text-6xl">
          Psychologist Office in Schaumburg, Illinois
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-gray-700 md:text-xl">
          Find the office address, hours, languages, practical access information, services, and answers to common questions before your visit.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-[#2f594f] px-5 py-3 font-semibold text-white transition-colors hover:bg-[#1f3f37]"
          >
            Open in Google Maps
          </a>
          <a
            href="/contact/"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-[#2f594f] px-5 py-3 font-semibold text-[#2f594f] transition-colors hover:bg-white"
          >
            Contact the Practice
          </a>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 xl:py-24">
      <div class="mx-auto max-w-[1200px] px-5 md:px-10 xl:px-24">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-lg border border-gray-200 p-6">
            <p class="mb-3 text-sm font-bold uppercase text-[#2f594f]">Address</p>
            <address class="not-italic leading-relaxed text-gray-700">
              <strong class="text-[#1a1a1a]">Center for PTA</strong><br />
              1320 Tower Rd, Suite 156<br />
              Schaumburg, IL 60173
            </address>
          </div>
          <div class="rounded-lg border border-gray-200 p-6">
            <p class="mb-3 text-sm font-bold uppercase text-[#2f594f]">Office hours</p>
            <p class="leading-relaxed text-gray-700">
              Monday-Friday<br />
              <strong class="text-[#1a1a1a]">9:00 AM-8:00 PM</strong><br />
              Saturday-Sunday: Closed
            </p>
          </div>
          <div class="rounded-lg border border-gray-200 p-6">
            <p class="mb-3 text-sm font-bold uppercase text-[#2f594f]">Languages</p>
            <p class="leading-relaxed text-gray-700">
              Clinical services are available in <strong class="text-[#1a1a1a]">English and Serbian</strong>. Confirm language availability for the requested service when scheduling.
            </p>
          </div>
          <div class="rounded-lg border border-gray-200 p-6">
            <p class="mb-3 text-sm font-bold uppercase text-[#2f594f]">Access and visits</p>
            <p class="leading-relaxed text-gray-700">
              The Google Business Profile lists wheelchair-accessible parking and a restroom. Appointments are recommended.
            </p>
          </div>
        </div>

        <div class="mt-10 border-l-4 border-[#2f594f] bg-[#f4f8f6] p-6 md:p-8">
          <h2 class="text-2xl font-bold text-[#1a1a1a]">Practice identity</h2>
          <p class="mt-3 max-w-4xl leading-relaxed text-gray-700">
            Center for PTA is the public-facing name of Center for Psychological Treatment and Assessment. The practice is associated with organization NPI-2 1306636089 and is led by Dr. Jelena Djurovic, Psy.D., an Illinois Licensed Clinical Psychologist, license #071-011433.
          </p>
        </div>
      </div>
    </section>

    <section class="border-y border-gray-200 bg-[#fcfbf9] py-16 xl:py-24">
      <div class="mx-auto max-w-[1200px] px-5 md:px-10 xl:px-24">
        <div class="max-w-3xl">
          <p class="mb-3 text-sm font-bold uppercase text-[#2f594f]">In-person care</p>
          <h2 class="text-3xl font-bold text-[#1a1a1a] md:text-4xl">Services available through the Schaumburg office</h2>
          <p class="mt-5 text-lg leading-relaxed text-gray-700">
            The right service depends on the referral question, clinical fit, age, format, and current availability. Contact the practice before visiting so the request can be matched to the appropriate next step.
          </p>
        </div>
        <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {officeServices.map((service) => (
            <a href={service.path} class="rounded-lg border border-gray-200 bg-white p-6 transition-colors hover:border-[#2f594f]">
              <h3 class="text-xl font-bold text-[#1a1a1a]">{service.name}</h3>
              <p class="mt-3 leading-relaxed text-gray-700">{service.description}</p>
              <span class="mt-5 inline-block font-semibold text-[#2f594f]">View service</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-16 xl:py-24">
      <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-5 md:px-10 lg:grid-cols-2 xl:px-24">
        <div>
          <h2 class="text-3xl font-bold text-[#1a1a1a]">Nearby communities</h2>
          <p class="mt-5 text-lg leading-relaxed text-gray-700">
            The Schaumburg office is available to clients from Schaumburg and nearby northwest suburban communities, including {nearbyCommunities.join(', ')}. Availability depends on the requested service and clinical fit, not on residency in a particular suburb.
          </p>
        </div>
        <div>
          <h2 class="text-3xl font-bold text-[#1a1a1a]">Traveling from outside Illinois</h2>
          <p class="mt-5 text-lg leading-relaxed text-gray-700">
            A person who lives outside Illinois may contact Center for PTA about traveling to Schaumburg for an in-person psychological evaluation. The referral question, records, language, service fit, and scheduling should be confirmed before making travel plans.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#2f594f] py-14 text-white">
      <div class="mx-auto max-w-[1000px] px-5 text-center md:px-10">
        <h2 class="text-3xl font-bold">Illinois telehealth boundary</h2>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-white/90">
          Dr. Djurovic is licensed to practice in Illinois. Telehealth may be available only when every participating client is physically located in Illinois at the time of the session and the format is clinically appropriate.
        </p>
      </div>
    </section>

    <FaqSection
      title="Schaumburg Office FAQ"
      intro="Practical answers about the location, hours, services, languages, accessibility, insurance verification, and scheduling."
      faqs={englishLocalFaqItems}
    />

    <section class="border-t border-gray-200 bg-[#fcfbf9] py-14">
      <div class="mx-auto flex max-w-[1000px] flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center md:px-10">
        <div>
          <p class="text-sm font-bold uppercase text-[#2f594f]">Before you visit</p>
          <h2 class="mt-2 text-2xl font-bold text-[#1a1a1a]">Confirm fit and current availability</h2>
        </div>
        <a href="/contact/" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-[#2f594f] px-5 py-3 font-semibold text-white transition-colors hover:bg-[#1f3f37]">
          Contact Center for PTA
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
