---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import PageAddressCard from '../components/PageAddressCard.astro';
import PageBreadcrumbs from '../components/PageBreadcrumbs.astro';

const facts = [
  'TMS and PrTMS clinic located in Evanston, Illinois',
  'FDA-cleared TMS may be considered for eligible patients with treatment-resistant depression, depending on the device and indication',
  'R Hope describes personalized planning, accelerated scheduling options, and mobile TMS support',
  'Eligibility, expected benefits, risks, costs, and insurance coverage must be confirmed directly with the R Hope clinical team'
];

const faqItems = [
  {
    question: 'Is R Hope Treatment part of Center for PTA?',
    answer:
      'No. Center for PTA and R Hope Treatment are separate clinical practices. Center for PTA is located in Schaumburg, and R Hope Treatment is located in Evanston.'
  },
  {
    question: 'Does Center for PTA provide TMS?',
    answer:
      'No. Center for PTA provides psychotherapy and psychological assessment within its own scope of practice. R Hope Treatment separately provides TMS services and determines whether its medical care may be appropriate.'
  },
  {
    question: 'Where are Center for PTA and R Hope Treatment located?',
    answer:
      'Center for PTA is located at 1320 Tower Rd, Suite 156, Schaumburg, IL 60173. R Hope Treatment lists its clinic at 1335 Dodge Ave, Evanston, IL 60201.'
  },
  {
    question: 'Who determines whether TMS is appropriate and whether insurance may cover it?',
    answer:
      'The R Hope clinical and administrative teams determine eligibility, treatment planning, scheduling, costs, and insurance verification for R Hope services. Center for PTA does not make those determinations or promise insurance coverage.'
  },
  {
    question: 'Where should current R Hope services and contact details be confirmed?',
    answer:
      'Confirm current services, clinical information, availability, and insurance details directly with R Hope Treatment or on its official Evanston website, because those details may change.'
  }
];
---

<Layout
  title="R Hope Treatment: TMS Referral Information | Center for PTA"
  description="Learn about R Hope Treatment, a separate TMS clinic in Evanston, Illinois, and how its services differ from care provided by Center for PTA."
  faqItems={faqItems}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#fcfbf9] overflow-hidden">
    <div class="absolute top-[20%] right-[-10%] w-[40%] h-[60%] bg-[#fdf3df] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <PageBreadcrumbs currentLabel="R Hope Treatment Referral Information" align="center" />
      <p class="text-[15px] xl:text-lg font-bold text-[#2f594f] uppercase tracking-widest mb-4">Independent referral resource</p>
      <h1 class="text-4xl md:text-6xl xl:text-[72px] font-extrabold text-[#1a1a1a] leading-tight tracking-tight mb-8">
        R Hope Treatment: TMS Referral Information
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
        Clear information about outside services that may be relevant when a client needs care beyond the scope of psychotherapy or psychological assessment.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start bg-[#fcfbf9] border border-gray-100 rounded-[3rem] p-8 md:p-12 xl:p-16 shadow-lg">
        
        <div class="lg:w-1/2">
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#147b6a] mb-6">R Hope Treatment</h2>
          <h3 class="text-xl md:text-2xl font-bold text-[#1a1a1a] mb-6">Independent TMS Clinic in Evanston</h3>
          
          <div class="space-y-4 text-gray-700 text-[15px] md:text-lg leading-relaxed font-medium">
            <p>R Hope Treatment is a separate clinical practice in Evanston that offers transcranial magnetic stimulation (TMS) and PrTMS-informed services. Its public website describes FDA-cleared TMS for eligible patients with treatment-resistant depression, along with personalized planning, accelerated scheduling conversations, and mobile TMS support.</p>
            <p>TMS is a medical treatment. Whether it is appropriate depends on an individual clinical evaluation, the device and indication being considered, medical history, and other factors reviewed by the treating team. Center for PTA does not provide TMS and does not determine eligibility for R Hope services.</p>
            <p>Center for PTA may provide psychotherapy or psychological assessment within its own scope of practice. R Hope independently provides its medical evaluation, treatment planning, informed-consent process, scheduling, billing, and insurance verification.</p>
            <p>This page is intended to help visitors understand the difference between the two practices. It is not a treatment recommendation, statement of eligibility, insurance promise, or guarantee of results.</p>
          </div>
          
          <div class="mt-8 pt-6 border-t border-gray-200">
            <p class="font-bold text-[#1a1a1a]">R Hope Treatment</p>
            <p class="text-gray-600 mt-1">1335 Dodge Ave, Evanston, IL 60201</p>
            <p class="text-gray-600 mt-1"><a href="tel:+18478689369" class="font-semibold hover:text-[#2f594f]">(847) 868-9369</a> · <a href="mailto:office@rhopetreatment.com" class="font-semibold hover:text-[#2f594f]">office@rhopetreatment.com</a></p>
            <a href="https://rhopetreatment.com/" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 font-bold text-[#0d5c4e] hover:text-[#2f594f]">
              Review current services on the official R Hope website <span aria-hidden="true">&rarr;</span>
            </a>
            <p class="mt-3 text-sm text-gray-500">Public details last checked August 29, 2026. Confirm current clinical and insurance information directly with R Hope.</p>
          </div>
        </div>

        <div class="lg:w-1/2 bg-white rounded-3xl p-8 xl:p-10 shadow-sm border border-gray-100 w-full">
          <h3 class="text-2xl font-bold text-[#1a1a1a] mb-8 flex items-center">
            <svg class="w-8 h-8 text-[#fcc13e] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            What to Confirm Directly
          </h3>
          <div class="space-y-6">
            {facts.map(fact => (
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-[#d1f3f1] text-[#147b6a] flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <p class="text-lg text-gray-800 font-medium leading-relaxed">{fact}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <FaqSection
    title="R Hope Treatment and TMS FAQs"
    intro="Answers that distinguish the two practices, their locations, and who is responsible for TMS decisions."
    faqs={faqItems}
  />

  <PageAddressCard />

  <Footer />
</Layout>
