---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Quote from '../components/Quote.astro';
import Services from '../components/Services.astro';
import SpecialtyTopics from '../components/SpecialtyTopics.astro';
import About from '../components/About.astro';
import LocalOfficeFaq from '../components/LocalOfficeFaq.astro';
import Footer from '../components/Footer.astro';
import { mapUrl, practiceDescription } from '../utils/seo';
import { englishLocalFaqItems, nearbyCommunities } from '../utils/local-practice-data.js';
---

<Layout
  title="Psychologist in Schaumburg, IL | Center for PTA"
  description={practiceDescription}
  faqItems={englishLocalFaqItems}
>
  <!-- 1. Hero + Navbar -->
  <Hero />

  <!-- 2. Quote -->
  <Quote />

  <!-- 3. Services (4 columns) -->
  <Services />

  <!-- 4. Specialty Topics -->
  <SpecialtyTopics />

  <!-- 5. About -->
  <About />

  <!-- 6. Local office and practical questions -->
  <LocalOfficeFaq
    eyebrow="Schaumburg office"
    title="Local care in Schaumburg and across Illinois"
    intro="Clear answers about visiting the office, telehealth boundaries, language options, insurance verification, and traveling to Illinois for an in-person evaluation."
    addressLabel="Office address"
    nearbyLabel="Nearby communities"
    nearbyCommunities={nearbyCommunities}
    mapLabel="Open in Google Maps"
    mapUrl={mapUrl}
    contactLabel="Contact Center for PTA"
    contactPath="/contact/"
    faqs={englishLocalFaqItems}
  />

  <!-- 7. Footer -->
  <Footer />
</Layout>
