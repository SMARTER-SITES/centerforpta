---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageBreadcrumbs from '../components/PageBreadcrumbs.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import LocalServiceArea from '../components/LocalServiceArea.astro';
import AuthorBioBox from '../components/AuthorBioBox.astro';
import { getServiceStructuredData } from '../utils/seo';

const cases = [
  { title: "Asylum Cases", desc: "Documenting psychological trauma, PTSD, or other mental health effects related to persecution or feared persecution in a home country." },
  { title: "Extreme Hardship Waivers", desc: "Describing the exceptional and unusually difficult hardship a U.S. citizen or permanent resident may experience if a family member is deported." },
  { title: "VAWA (Violence Against Women Act)", desc: "Providing clinical evidence of emotional and psychological abuse for people who have been in an abusive relationship with a U.S. citizen or permanent resident." },
  { title: "U Visas and T Visas", desc: "Evaluating mental health effects for people who have experienced serious physical or psychological abuse, human trafficking, or other serious crimes." },
  { title: "Cancellation of Removal", desc: "Evaluating the severe psychological impact deportation may have on the applicant, children, or other qualifying family members." }
];

const relatedLinks = [
  {
    href: '/contact/',
    title: 'Request an Immigration Evaluation Consultation',
    desc: 'Contact the office to ask about scheduling, timelines, language availability, or coordination with your attorney.'
  },
  {
    href: '/rates-and-insurance/',
    title: 'Rates and Payment Information',
    desc: 'Review evaluation pricing and practical planning information before scheduling an immigration assessment.'
  },
  {
    href: '/blog/what-to-expect-during-an-immigration-psychological-evaluation/',
    title: 'What to Expect During the Evaluation',
    desc: 'Read the step-by-step guide to interviews, documents, reports, attorney coordination, and telehealth boundaries.'
  }
];

const pageDescription =
  'Immigration psychological evaluations in Schaumburg, IL for asylum, hardship waivers, VAWA, U visas, T visas, and attorney-coordinated cases.';

const faqItems = [
  {
    question: 'What types of immigration cases can a psychological evaluation support?',
    answer:
      'A psychological evaluation can support asylum, extreme hardship waiver, VAWA, U visa, T visa, and cancellation of removal cases when mental health documentation is clinically relevant to the matter.'
  },
  {
    question: 'Do you coordinate with immigration attorneys?',
    answer:
      'Yes. When the client authorizes communication, Dr. Jelena Djurovic can coordinate with the attorney so the evaluation addresses the referral question and clinically relevant parts of the case.'
  },
  {
    question: 'How much does an immigration psychological evaluation cost?',
    answer:
      'Immigration evaluations start at $1,500. The final scope may depend on the type of case, documentation to review, attorney coordination, and deadlines.'
  },
  {
    question: 'What languages are available for immigration evaluations?',
    answer:
      'Evaluations are available in Serbian and English. Dr. Djurovic speaks conversational Spanish; contact the practice to discuss whether Spanish-language support is appropriate for your needs.'
  },
  {
    question: 'Can the evaluation be completed online in Illinois?',
    answer:
      'In-person appointments are available in Schaumburg, and an online format may be available for clients located in Illinois when it is clinically appropriate for the evaluation.'
  }
];

const localSectionParagraphs = [
  'The Schaumburg office is located at 1320 Tower Rd, Suite 156, making it accessible for clients and attorneys in Schaumburg, Hoffman Estates, Arlington Heights, Palatine, Rolling Meadows, Elk Grove Village, and the broader northwest suburbs.',
  'Immigration evaluations may also be available online for clients in other parts of Illinois when that format is clinically appropriate and aligned with the needs of the case.'
];

const serviceStructuredData = getServiceStructuredData({
  name: 'Immigration Psychological Evaluations',
  description: pageDescription,
  path: '/immigration-evaluations/',
  serviceType: 'Immigration Psychological Evaluation'
});
---

<Layout
  title="Immigration Psychological Evaluations in Schaumburg, IL"
  description={pageDescription}
  faqItems={faqItems}
  structuredData={serviceStructuredData}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#fcfbf9] overflow-hidden">
    <div class="absolute bottom-[-20%] left-[20%] w-[30%] h-[30%] bg-[#f4e8e1] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <PageBreadcrumbs currentLabel="Immigration Psychological Evaluations in Schaumburg, IL" align="center" />
      <p class="text-[15px] xl:text-lg font-bold text-[#2f594f] uppercase tracking-widest mb-4">Our Services</p>
      <h1 class="text-4xl md:text-5xl xl:text-[64px] font-extrabold text-[#1a1a1a] leading-tight tracking-tight mb-8">
        Immigration Psychological Evaluations in Schaumburg, IL
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
        Clinically thorough immigration evaluations for asylum, hardship waivers, VAWA, U visas, T visas, and cancellation of removal cases across Illinois.
      </p>
    </div>
  </section>

  <!-- Explanation Section -->
  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
        <div class="lg:w-1/2">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a] mb-6">Clinically Thorough Evaluations That Support Immigration Cases</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-6">
            A well-prepared immigration psychological evaluation can be an important part of a strong legal case. We provide detailed, clinically grounded evaluations that clearly and professionally document trauma, hardship circumstances, and mental health impact.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed mb-8">
            The process includes a clinical interview, psychological testing when appropriate, and a written report tailored to the legal needs of the case. Dr. Jelena Djurovic regularly works with attorneys and understands the importance of clarity, credibility, and timely communication.
          </p>
          <div class="bg-[#e0eae5] border-l-4 border-[#147b6a] p-6 rounded-r-xl">
             <p class="text-[17px] text-[#0d5c4e] font-bold">
              Testing and assessments are offered in Serbian and English. Contact the practice to discuss Spanish-language needs.
            </p>
          </div>
        </div>

        <div class="lg:w-1/2 w-full space-y-4">
          <h3 class="text-2xl font-bold text-[#1a1a1a] mb-6">Types of Immigration Cases We Support</h3>
          {cases.map(type => (
            <div class="bg-[#fcfbf9] border border-gray-100 p-6 rounded-2xl hover:shadow-md transition-shadow">
              <h4 class="text-xl font-bold text-[#2f594f] mb-2">{type.title}</h4>
              <p class="text-gray-600 leading-relaxed">{type.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 xl:py-24 bg-[#fcfbf9] relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-10 lg:gap-16 items-start">
        <div>
          <p class="text-[15px] xl:text-lg font-bold text-[#2f594f] uppercase tracking-widest mb-4">For Attorneys and Clients</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a] mb-6">Clinical Documentation for Immigration Matters</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-6">
            Immigration psychological evaluations should be clinically grounded, clear, and focused on the legal question. The goal is not generic therapy language, but a careful evaluation that documents symptoms, trauma history, hardship circumstances, functioning, and relevant clinical findings.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed">
            With written consent, the office can coordinate with the attorney about deadlines, case type, documentation, and the specific clinical questions the evaluation needs to address.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="bg-white rounded-[1.75rem] border border-gray-100 p-7 shadow-sm">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">Attorney coordination</h3>
            <p class="text-gray-700 leading-relaxed">Referral questions, deadlines, documentation, and case-specific concerns can be reviewed when the client authorizes communication.</p>
          </div>
          <div class="bg-white rounded-[1.75rem] border border-gray-100 p-7 shadow-sm">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">Detailed report</h3>
            <p class="text-gray-700 leading-relaxed">Reports are prepared to clearly document clinical findings for the immigration process and attorney review.</p>
          </div>
          <div class="bg-white rounded-[1.75rem] border border-gray-100 p-7 shadow-sm">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">Language availability</h3>
            <p class="text-gray-700 leading-relaxed">Evaluations are available in Serbian and English. Contact the practice to discuss Spanish-language needs.</p>
          </div>
          <div class="bg-white rounded-[1.75rem] border border-gray-100 p-7 shadow-sm">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">Available in Illinois</h3>
            <p class="text-gray-700 leading-relaxed">Come in person in Schaumburg or ask whether an online format is appropriate for an evaluation in Illinois.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 xl:py-24 bg-[#fcfbf9] relative">
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="bg-white border border-gray-100 rounded-[2rem] p-8 md:p-10 shadow-sm">
        <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a] mb-6">Our Immigration Evaluation Process</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          The process typically includes an initial consultation, a detailed clinical interview, psychological testing when clinically indicated, and a written report prepared for immigration proceedings. We coordinate carefully with clients and, when appropriate, their attorneys to make sure the evaluation addresses the needs of the case.
        </p>
      </div>
    </div>
  </section>

  <LocalServiceArea
    serviceName="Immigration Psychological Evaluations"
    paragraphs={localSectionParagraphs}
  />

  <FaqSection
    title="Immigration Evaluation FAQ"
    intro="Common questions about case types, attorney coordination, cost, languages, and location."
    faqs={faqItems}
  />

  <AuthorBioBox />

  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">Related Resources</h2>
        <p class="text-lg text-gray-700">
          These pages can help you prepare for the evaluation process and contact the office quickly.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedLinks.map((link) => (
          <a href={link.href} class="bg-[#fcfbf9] p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{link.title}</h3>
            <p class="text-gray-600 leading-relaxed">{link.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA section -->
  <section class="py-20 md:py-28 bg-[#2f594f] relative overflow-hidden">
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 md:mb-8 tracking-tight">Strengthen Your Case Early</h2>
      <a href="/contact/" class="inline-flex items-center justify-center px-8 md:px-12 py-4 bg-[#fcc13e] text-[#1a1a1a] text-lg font-bold rounded-full hover:bg-white hover:text-[#2f594f] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        Contact Us
      </a>
    </div>
  </section>

  <Footer />
</Layout>
