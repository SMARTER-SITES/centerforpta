---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageBreadcrumbs from '../components/PageBreadcrumbs.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import LocalServiceArea from '../components/LocalServiceArea.astro';
import AuthorBioBox from '../components/AuthorBioBox.astro';
import PageAddressCard from '../components/PageAddressCard.astro';
import { getServiceStructuredData } from '../utils/seo';

const concerns = [
  { title: "Anxiety & Stress", desc: "Learn to manage overwhelming worry, panic attacks, and daily stress with evidence-based coping strategies." },
  { title: "Depression & Mood", desc: "Find hope and motivation when feeling sad, hopeless, or stuck. We help you rebuild your emotional resilience." },
  { title: "Trauma & PTSD", desc: "Heal from past experiences in a safe, trauma-informed environment using proven therapeutic approaches." },
  { title: "Relationships", desc: "Improve communication, rebuild trust, and navigate family or marital challenges effectively." },
  { title: "Life Transitions", desc: "Get support while navigating career changes, loss, grief, separation, or other significant life shifts." },
  { title: "Substance Use", desc: "Regain control over drinking or drug use with compassionate, non-judgmental support and effective interventions." },
  { title: "ADHD & Focus", desc: "Learn to cope effectively with scattered thoughts and improve your daily functioning and quality of life." },
  { title: "Chronic Pain & Illness", desc: "Explore the mind-body connection and learn interventions to live your life as freely as possible." }
];

const relatedLinks = [
  {
    href: '/rates-and-insurance/',
    title: 'Rates and Insurance',
    desc: 'Review insurance plans, private pay options, and next steps before scheduling therapy.'
  },
  {
    href: '/contact/',
    title: 'Request a Consultation',
    desc: 'Reach out to ask about individual, couples, family, or telehealth therapy in Illinois.'
  },
  {
    href: '/psychological-assessment/',
    title: 'Psychological Assessment',
    desc: 'Explore testing for ADHD, autism, diagnostic clarification, and school or workplace accommodations.'
  },
  {
    href: '/blog/2026-03-01-why-seek-psychotherapy/',
    title: 'Why Seek Psychotherapy?',
    desc: 'Read when therapy may help and what a supportive therapeutic process can offer.'
  },
  {
    href: '/blog/2026-03-02-how-do-i-find-the-right-therapist/',
    title: 'How Do I Find the Right Therapist?',
    desc: 'Use practical questions to consider fit, credentials, approach, and next steps.'
  },
  {
    href: '/blog/why-am-i-so-hard-on-myself/',
    title: 'Why Am I So Hard on Myself?',
    desc: 'Learn how self-criticism develops and how self-compassion can support change.'
  }
];

const specialtyLinks = [
  {
    href: '/couples-therapy/',
    title: 'Couples Therapy',
    desc: 'Relationship counseling for communication, recurring conflict, trust, and emotional distance.'
  },
  {
    href: '/womens-mental-health-therapy/',
    title: "Women's Mental Health Therapy",
    desc: 'Support for reproductive challenges, body image concerns, and life-stage stress.'
  },
  {
    href: '/self-compassion-therapy/',
    title: 'Self-Compassion Therapy',
    desc: 'Help for harsh self-criticism, shame, perfectionism, and burnout.'
  },
  {
    href: '/weight-loss-counseling/',
    title: 'Weight Loss Counseling',
    desc: 'Support for emotional eating, body image, and lasting behavior change.'
  },
  {
    href: '/bariatric-surgery-counseling/',
    title: 'Bariatric Surgery Counseling',
    desc: 'Emotional support before and after bariatric surgery.'
  },
  {
    href: '/divorce-counseling/',
    title: 'Divorce Counseling',
    desc: 'Support before separation and after divorce during major life transition.'
  },
  {
    href: '/prenatal-therapy/',
    title: 'Prenatal Therapy',
    desc: 'Therapy support during pregnancy for stress, anxiety, and emotional adjustment.'
  },
  {
    href: '/postpartum-therapy/',
    title: 'Postpartum Therapy',
    desc: 'Postnatal support for mood changes, overwhelm, and recovery after birth.'
  }
];

const pageDescription =
  'Therapy in Schaumburg for individuals, couples, and families seeking support with anxiety, trauma, grief, relationships, and life transitions.';

const faqItems = [
  {
    question: 'Where are in-person therapy sessions offered?',
    answer:
      'In-person therapy is available at the Center for PTA office at 1320 Tower Rd, Suite 156, Schaumburg, IL 60173. The office is accessible from Hoffman Estates, Arlington Heights, Palatine, Rolling Meadows, and nearby northwest suburbs.'
  },
  {
    question: 'Is telehealth therapy available outside Illinois?',
    answer:
      'Dr. Jelena Djurovic is licensed to practice in Illinois. Telehealth may be available only when every participating client is physically located in Illinois at the time of the session and the format is clinically appropriate.'
  },
  {
    question: 'Is therapy available in Serbian and English?',
    answer:
      'Yes. Therapy services are available in Serbian and English. Contact Center for PTA to discuss the requested service, language preference, clinical fit, and current availability.'
  },
  {
    question: 'How do I know whether I need therapy or psychological assessment?',
    answer:
      'Therapy focuses on ongoing support, coping, relationships, and emotional change. Psychological assessment is a structured evaluation designed to answer a specific diagnostic or referral question. Center for PTA can help you discuss which service is the more appropriate starting point.'
  }
];

const localSectionParagraphs = [
  'Dr. Jelena Djurovic provides in-person therapy at the Center for PTA office at 1320 Tower Rd, Suite 156 in Schaumburg. The office serves Schaumburg and nearby northwest suburban communities, including Hoffman Estates, Arlington Heights, Palatine, Rolling Meadows, Elk Grove Village, and Streamwood.',
  'Telehealth may be available only when every participating client is physically located in Illinois during the session and the format is clinically appropriate. Therapy services are available in Serbian and English.'
];

const serviceStructuredData = getServiceStructuredData({
  name: 'Therapy in Schaumburg, IL',
  description: pageDescription,
  path: '/therapy/',
  serviceType: 'Psychotherapy'
});
---

<Layout
  title="Therapy in Schaumburg, IL | Center for PTA"
  description={pageDescription}
  faqItems={faqItems}
  structuredData={serviceStructuredData}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#fcfbf9] overflow-hidden">
    <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-[#e0eae5] rounded-full opacity-60 blur-3xl lg:blur-[80px]"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <PageBreadcrumbs currentLabel="Therapy in Schaumburg, IL" align="center" />
      <p class="text-[15px] xl:text-lg font-bold text-[#2f594f] uppercase tracking-widest mb-4">Our Services</p>
      <h1 class="text-4xl md:text-5xl xl:text-[64px] font-extrabold text-[#1a1a1a] leading-tight tracking-tight mb-8">
        Therapy in Schaumburg, IL
      </h1>
      <p class="text-lg md:text-2xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
        Individual, couples, family, and telehealth therapy for anxiety, depression, trauma, ADHD, relationship issues, grief, and life transitions.
      </p>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="flex flex-col md:flex-row gap-12 items-center">
        <div class="md:w-1/2">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1a1a1a] mb-6">A Personalized Approach to Therapy</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-6">
            Starting therapy can feel overwhelming, but you do not have to navigate difficult emotions or life changes alone. We offer a supportive, non-judgmental space where you can better understand what you are experiencing and build meaningful change over time.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed">
            Dr. Jelena Djurovic provides evidence-based therapy tailored to your needs, goals, history, and strengths, helping you move toward greater stability, stronger relationships, and deeper self-understanding.
          </p>
        </div>
        <div class="md:w-1/2 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Individual Therapy</h3>
            <p class="text-gray-600">One-on-one sessions focused on your personal growth, healing, and specific psychological needs.</p>
          </div>
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Couples Therapy</h3>
            <p class="text-gray-600">Learn effective communication skills and problem-solving strategies to strengthen your relationship.</p>
          </div>
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Family Therapy</h3>
            <p class="text-gray-600">Resolve conflicts and improve the family dynamic through guided, constructive dialogue.</p>
          </div>
          <div class="bg-[#fcfbf9] p-6 rounded-2xl border border-gray-100">
            <h3 class="font-bold text-[#2f594f] text-xl mb-3">Telehealth</h3>
            <p class="text-gray-600">Secure virtual therapy may be available when every participating client is physically located in Illinois during the session.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Treat Section -->
  <section class="py-16 xl:py-24 bg-[#fcfbf9] relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">What We Treat</h2>
        <p class="text-lg text-gray-700">We offer specialized treatment for a wide range of emotional, behavioral, and psychological concerns.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8">
        {concerns.map(concern => (
          <div class="bg-white p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{concern.title}</h3>
            <p class="text-[15px] text-gray-600 leading-relaxed">{concern.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">Specialized Therapy Topics</h2>
        <p class="text-lg text-gray-700">
          If you are looking for support around a more specific concern, these pages can help you find the best fit more quickly.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {specialtyLinks.map((link) => (
          <a href={link.href} class="bg-[#fcfbf9] p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{link.title}</h3>
            <p class="text-gray-600 leading-relaxed">{link.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 xl:py-24 bg-white relative">
    <div class="max-w-[1200px] mx-auto px-5 md:px-10 xl:px-24">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-[#1a1a1a] mb-6">Planning Your Next Step</h2>
        <p class="text-lg text-gray-700">
          These practical pages and clinical guides can help you understand fit, cost, scheduling, and what to expect from therapy.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedLinks.map((link) => (
          <a href={link.href} class="bg-[#fcfbf9] p-8 rounded-3xl border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1a1a1a] mb-3">{link.title}</h3>
            <p class="text-gray-600 leading-relaxed">{link.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LocalServiceArea
    serviceName="Therapy"
    title="Therapy in Schaumburg and Telehealth Across Illinois"
    paragraphs={localSectionParagraphs}
  />

  <FaqSection
    title="Therapy in Schaumburg FAQ"
    intro="Practical answers about the office, telehealth boundaries, languages, and choosing the right service."
    faqs={faqItems}
  />

  <AuthorBioBox />
  <PageAddressCard />

  <!-- CTA section -->
  <section class="py-20 md:py-28 bg-[#2f594f] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-[#3a6e62] rounded-full blur-3xl opacity-50 -translate-y-1/2 translate-x-1/2"></div>
    <div class="max-w-[1000px] mx-auto px-5 md:px-10 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 md:mb-8 tracking-tight">Begin your healing journey</h2>
      <a href="/contact/" class="inline-flex items-center justify-center px-8 md:px-12 py-4 bg-[#fcc13e] text-[#1a1a1a] text-lg font-bold rounded-full hover:bg-white hover:text-[#2f594f] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        Contact Us
      </a>
    </div>
  </section>

  <Footer />
</Layout>
